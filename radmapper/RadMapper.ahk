    /**
     * The guard flag is stored ON the layout, so it survives a restart and
     * travels with an exported config; arming it here also starts the timer
     * now rather than at the next apply.
     */
    static LayoutGuardSel() {
        lay := Atlas.LayoutSel()
        if !IsObject(lay) {
            Lumi.Toast("Pick an arrangement in the list first", "warn")
            return
        }
        name := MGet(lay, "name", "")
        on := MGet(lay, "guard", 0) ? 0 : 1
        lay["guard"] := on
        ; Only one layout can be enforced at a time -- two guards would take
        ; turns dragging the same window between two arrangements.
        if on {
            for other in g_Cfg["layouts"] {
                if (MGet(other, "name", "") != name)
                    other["guard"] := 0
            }
            LayoutGuardArm(name)
        } else if (g_LayoutGuard = name) {
            LayoutGuardDisarm()
        }
        SaveCfg()
        Atlas.Build()
        Lumi.Toast(on ? ("Now keeping “" name "” in place")
                      : ("No longer keeping “" name "” in place"),
            on ? "jade" : "magenta")
    }

