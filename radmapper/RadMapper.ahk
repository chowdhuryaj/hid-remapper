AppDlg(editRow) {
    app := editRow ? g_Cfg["apps"][editRow] : 0
    dlg := Gui("+Owner" . g_UI.g.Hwnd, editRow ? "Edit app profile" : "Add app profile")
    StyleDlg(dlg)
    dlg.AddText("x12 y14 w60", "Name:")
    edName := dlg.AddEdit("x120 y10 w260", app ? app["name"] : "")
    dlg.AddText("x12 y46 w100", "Match (;-sep):")
    m := ""
    if app {
        for entry in MGet(app, "match", [])
            m .= (m = "" ? "" : ";") entry
    }
    edMatch := dlg.AddEdit("x120 y42 w360", m)
    dlg.AddText("x120 y74 w360 cGray",
        "process.exe   |   ahk_exe process.exe   |   title:window title fragment")
    ok := dlg.AddButton("x120 y104 w90 Default", "OK")
    dlg.AddButton("x+10 w90", "Cancel").OnEvent("Click", (*) => ModalClose(dlg))
    ok.OnEvent("Click", (*) => AppOk(dlg, editRow, edName, edMatch))
    ModalOpen(dlg)
}

AppOk(dlg, editRow, edName, edMatch) {
    name := Trim(edName.Value)
    if (name = "" || name = "*" || name = "Global (all apps)") {
        MsgBox("Enter a profile name (not * or the reserved Global label).", "RadMapper", "Iconx Owner" . dlg.Hwnd)
        return
    }
    matches := []
    loop parse edMatch.Value, ";" {
        e := Trim(A_LoopField)
        if (e != "")
            matches.Push(e)
    }
    if (matches.Length = 0) {
        MsgBox("Enter at least one match entry.", "RadMapper", "Iconx Owner" . dlg.Hwnd)
        return
    }
    if editRow {
        old := g_Cfg["apps"][editRow]["name"]
        if (old != name) {
            for row in g_Cfg["bindings"] {
                if (MGet(row, "app", "*") = old)
                    row["app"] := name
            }
        }
        g_Cfg["apps"][editRow]["name"] := name
        g_Cfg["apps"][editRow]["match"] := matches
    } else {
        app := Map()
        app["name"] := name
        app["match"] := matches
        g_Cfg["apps"].Push(app)
    }
    SaveCfg()
    AfterCfgChange()
    RefreshAll()
    ModalClose(dlg)
}

AppDelete() {
    row := g_UI.lvApps.GetNext()
    if !row
        return
    name := g_Cfg["apps"][row]["name"]
    used := 0
    for r in g_Cfg["bindings"] {
        if (MGet(r, "app", "*") = name)
            used += 1
    }
    msg := used > 0
        ? "Profile '" name "' is used by " used " row(s); they will be switched to Global (all apps). Delete?"
        : "Delete profile '" name "'?"
    if (MsgBox(msg, "RadMapper", "YesNo Icon?") != "Yes")
        return
    for r in g_Cfg["bindings"] {
        if (MGet(r, "app", "*") = name)
            r["app"] := "*"
    }
    g_Cfg["apps"].RemoveAt(row)
    SaveCfg()
    AfterCfgChange()
    RefreshAll()
}

; Capture where the pointer is IN THREE SECONDS as the selected profile's
; park spot. A countdown rather than "click here": the spot you want is
; usually inside another application, and clicking a button in this window
; to record a point in that one is impossible.
ParkGrab() {
    row := g_UI.lvApps.GetNext()
    if !row {
        g_UI.txtGrab.Text := "Select an app profile first."
        return
    }
    g_UI.parkRow := row
    g_UI.txtGrab.Text := "Move the pointer to the spot for '"
        . g_Cfg["apps"][row]["name"] "' — capturing in 3 s"
    SetTimer(ParkGrabDone, -3000)
}

ParkGrabDone(*) {
    row := g_UI.HasOwnProp("parkRow") ? g_UI.parkRow : 0
    if (!row || row > g_Cfg["apps"].Length)
        return
    name := g_Cfg["apps"][row]["name"]
    RM_GetPos(&px, &py)
    SetPark(name, px, py)
    g_UI.txtGrab.Text := "Park spot for " name ": " px ", " py
    RefreshApps()
}

ParkClearSel() {
    row := g_UI.lvApps.GetNext()
    if !row
        return
    name := g_Cfg["apps"][row]["name"]
    ClearPark(name)
    g_UI.txtGrab.Text := "Park spot cleared for " name
    RefreshApps()
}

AppGrab() {
    g_UI.txtGrab.Text := "Focus the target window... capturing in 3 s"
    SetTimer(AppGrabDone, -3000)
}

AppGrabDone(*) {
    try {
        exe := WinGetProcessName("A")
        g_UI.txtGrab.Text := "Captured: " exe "  (use it in a profile's Match)"
        A_Clipboard := exe
        HUD("Copied to clipboard: " exe)
    } catch {
        g_UI.txtGrab.Text := "Could not read the active window."
    }
}

