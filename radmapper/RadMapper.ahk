    "scrollPtrInvert", 0,      ; 1 = push to scroll instead of drag the page
    "scrollPtrPin", 1,         ; 1 = pin the cursor to the anchor while scrolling
    "scrollPtrMax", 20,        ; max notches emitted per 10 ms tick (runaway cap)
