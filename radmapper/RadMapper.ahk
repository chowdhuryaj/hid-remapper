SettingsApply() {
    ui := g_UI
    CfgSet("tapWindow", ClampInt(ui.edTap.Value, 30, 1000, 100))
    CfgSet("holdThreshold", ClampInt(ui.edHold.Value, 50, 2000, 200))
    CfgSet("dragThreshold", ClampInt(ui.edDrag.Value, 1, 200, 8))
    CfgSet("repeatRate", ClampInt(ui.edRep.Value, 10, 1000, 50))
    CfgSet("hud", ui.cbHud.Value)
    CfgSet("followFocus", ui.cbFollow.Value)
    CfgSet("teleportFlash", ui.cbTeleFlash.Value)
    CfgSet("psDictateKey", ui.edPsKey.Value)
    exes := []
    loop parse ui.edPsExes.Value, ";" {
        e := Trim(A_LoopField)
        if (e != "")
            exes.Push(e)
    }
    if (exes.Length > 0)
        g_Cfg["psExes"] := exes
    CfgSet("hkDictate", ui.edHkDictate.Value)
    CfgSet("hkPrevField", ui.edHkPrev.Value)
    CfgSet("hkNextField", ui.edHkNext.Value)
    CfgSet("hkTeleLeft", ui.edHkTeleL.Value)
    CfgSet("hkTeleRight", ui.edHkTeleR.Value)
    CfgSet("hkGui", ui.edHkGui.Value)
    CfgSet("hkPause", ui.edHkPause.Value)
    CfgSet("theme", ui.ddTheme.Value = 2 ? "light"
        : ui.ddTheme.Value = 3 ? "dark" : "auto")
    SaveCfg()
    AfterCfgChange()
    ApplyTheme(g_UI.g)
    NavPaint()
    HUD("Settings applied")
}

ClampInt(v, lo, hi, dflt) {
    if !IsInteger(v)
        return dflt
    n := Integer(v)
    return Min(Max(n, lo), hi)
}


; ── §12  TRAY, LIFECYCLE ────────────────────────────────────────────────────

UpdateTray() {
    A_IconTip := "RadMapper " RM_VERSION " — " (g_Enabled ? "running" : "PAUSED")
    try {
        if g_Enabled
            A_TrayMenu.Check("Enabled")
        else
            A_TrayMenu.Uncheck("Enabled")
    }
}

BuildTray() {
    A_TrayMenu.Delete()
    A_TrayMenu.Add("Settings…", (*) => ShowMain())
    A_TrayMenu.Add("Settings (classic)…", (*) => ShowClassic())
    A_TrayMenu.Add("Clipboard…", (*) => Shelf.Toggle("clip"))
    A_TrayMenu.Add("Scratchpad…", (*) => Shelf.Toggle("scratch"))
    A_TrayMenu.Add("Rendering self-test…", (*) => ShowGallery())
    A_TrayMenu.Add("Enabled", (*) => ToggleEnabled())
    A_TrayMenu.Add("Panic release", (*) => PanicRelease())
    A_TrayMenu.Add()
    A_TrayMenu.Add("Reload script", (*) => Reload())
    A_TrayMenu.Add("Exit", (*) => ExitApp())
    A_TrayMenu.Default := "Settings…"
    UpdateTray()
}

Cleanup(*) {
    global g_SpeedSaved, g_Problems
    SetTimer(Watchdog, 0)
    SetTimer(FollowTick, 0)
    RadialClose(false)
    TeleportSignalStop()
    g_Problems := []                         ; in-memory only, dies with us
    if g_CfgDirty
        SaveCfg()                            ; never drop a debounced slider value
    ForceReleaseActive()
    if (g_SpeedSaved != "") {
        RM_SetSpeed(g_SpeedSaved)
        g_SpeedSaved := ""
    }
    return 0
}

Init() {
    ; The error hook is registered by GpGFX's static __New as well, but that
    ; call sits INSIDE its try, after Gdip.Startup() -- so on a machine where
    ; the graphics stack fails to start (exactly when errors are most likely)
    ; it never runs, and an unhandled error raises a modal AutoHotkey dialog
    ; over the study. Registering it here too is idempotent (v2 moves an
    ; already-registered callback rather than adding it twice) and does not
    ; depend on the bundle.
    OnError(RadUnhandledError, -1)
    if !SingleCopyGuard()
        ExitApp(0)
    ResolveCfgPaths()                        ; must precede any config I/O
    LoadCfg()
    OnClipboardChange(ClipChanged)           ; feeds the clipboard shelf
    BuildMain()
    BuildTray()
    SyncHooks()
    RegisterKbHotkeys()
    AppSwitchBindKeys()                      ; AFTER RegisterKbHotkeys, and
                                             ; here rather than lazily on the
                                             ; wheel thread that opens the
                                             ; switcher: both set a HotIf
                                             ; context, and doing it there
                                             ; could clear theirs mid-register
    SyncFollowFocus()
    OnExit(Cleanup)
    SetTimer(Watchdog, 750)                  ; physical-state reconciliation
    ; TrayTip is (Text, Title, Options) in v2 -- Text first. (The old
    ; not-admin UIPI warning is gone: AJ's whole stack runs standard-user,
    ; so it was a false alarm on every launch.)
    TrayTip("Running. Double-click the tray icon or press " Cfg("hkGui")
        . " for settings.", "RadMapper " RM_VERSION)
    ; FIRST RUN (v0.6): a colleague who was handed this file should not have
    ; to find the tray icon. The first launch of each version opens the
    ; settings window on its Home page; every later launch stays quiet.
    if (Cfg("welcomedVer") != RM_VERSION) {
        CfgSet("welcomedVer", RM_VERSION)
        try SaveCfg()
        SetTimer(FirstRunOpen, -800)
    }
}

FirstRunOpen(*) {
    try ShowMain()
}

; ONE RADMAPPER PER MACHINE, whatever the file is called or where it lives.
; #SingleInstance only recognises the SAME script path, so RadMapper.ahk in
; Downloads and RadMapper.ahk on the desktop run side by side -- and two
; copies both hook the wheel: each one suppresses a notch and re-emits it,
; the OTHER copy's hook catches the re-emission and re-emits it again, and
; fast scrolling turns into lag and stalls (reported on 0.6.0.2, cause: an
; older copy still running). A named mutex is per machine, not per path.
global g_InstanceMutex := 0
SingleCopyGuard() {
    global g_InstanceMutex
    ; Keep the handle for the life of the process; the mutex dies with us.
    g_InstanceMutex := DllCall("CreateMutexW", "ptr", 0, "int", 0,
        "wstr", "Local\RadMapper-single-copy", "ptr")
    if (!g_InstanceMutex || A_LastError != 183)   ; 183 = ERROR_ALREADY_EXISTS
        return true
    ; Another copy owns the mutex. Do NOT try to kill it: it may be mid-hold
    ; with a button latched, and only its own exit path releases cleanly.
    MsgBox("Another RadMapper is already running, probably an older copy in "
        . "a different folder.`n`nTwo copies fight over the mouse wheel and "
        . "make scrolling lag.`n`nThis copy will now close. Right-click the "
        . "other RadMapper tray icon, choose Exit, then start this one again.",
        "RadMapper is already running", "Iconi")
    return false
}


; ══════════════════════════════════════════════════════════════════════════════
;  §13  BUNDLED: Lumi Atlas design system
; ══════════════════════════════════════════════════════════════════════════════

;==============================================================================
;  LumiAtlas.ahk  --  the Lumi Atlas design system + widget kit for GpGFX
;------------------------------------------------------------------------------
;  A vector UI kit for AutoHotkey v2, drawn entirely with GpGFX
;  (https://github.com/bceenaeiklmr/GpGFX). No Win32 child controls: every
;  surface, row, field and switch below is a shape on a layered window.
;
;  THE DESIGN WORLD -- "Lumi Atlas"
;    Neon hot pink, bright olive green and neon cyan, on a Dracula ground.
;
;    * GROUND is Dracula's obsidian, pushed a shade deeper so the neon has
;      somewhere to sit. Nothing pure black, nothing pure white.
;    * NEON HOT PINK (#FF2D95) carries IDENTITY and ALARM -- the window lid,
;      the active nav mark, the selected row, a click lock, the one
;      committing button, and (deepened to #FF1B6B) anything destructive.
;      It never fills a large area: neon is a highlighter, not a wall.
;    * BRIGHT OLIVE GREEN (#BCD62B) carries STATE -- running, engaged,
;      assigned, filled -- so the eye learns one rule: olive means the
;      machine is doing something. #8FA61E and #DCEB5A are its gradient ends.
;    * NEON CYAN (#00E9FF) carries INFORMATION and FOCUS -- hover, the edit
;      caret, app chips, anything the reader is being pointed at.
;
;    Three hues and no others: no amber, no violet, no teal. A warning is
;    the pale pink, an error the deep one -- the family says "attention",
;    the weight says how much.
;    * STRUCTURE does the rest: hairline rules, small radii, tick marks
;      under sliders, monospaced input codes. No gradients, no glows, no
;      pills, no decorative grid -- flat surfaces separated by hairlines.
;      That restraint is what keeps three neon hues from reading as a toy.
;
;    Contrast rule: body text is `ink` on `surface`/`raised` only. Accent
;    hues cover <=10% of pixels: strokes, 3 px indicators, chips, one filled
;    button per screen. Never accent-on-accent.
;
;  USING IT
;      Lumi.Gallery()            ; renders the whole kit for eyeballing
;  (In this single-file build GpGFX is bundled in §15 below; the kit needs
;  nothing else. Tray > "Rendering self-test" calls Gallery() for you.)
;
;  Every widget is a plain static method that draws into the CURRENT layer
;  (LayerStack.ActiveLayer) and returns a handle. Rebuild a screen with
;  lyr.Clear() -> redraw widgets -> lyr.Draw().
;
;  AHK v2 NOTE: handlers created inside a loop are built by small factory
;  methods (__RowClick and friends) rather than inline closures. A closure
;  captures the loop VARIABLE, not its value, so every row would otherwise
;  end up pointing at the last index.
;==============================================================================


class Lumi {

    ; ── TOKENS ──────────────────────────────────────────────────────────────
    ; Colours are ARGB strings, the form GpGFX's Color() parses natively.

    ; THREE HUES, one ground. Neon hot pink, bright olive green, neon cyan,
    ; sitting on the Dracula obsidian. Nothing else -- no amber, no violet,
    ; no teal. Every accent below is one of the three or a tint of it, which
    ; is what makes a three-colour scheme read as deliberate instead of as a
    ; palette that ran out.
    static C := Map(
        ; ground (Dracula, deepened) -- unchanged
        "abyss",    "0xFF15161F",   ; window ground, behind everything
        "surface",  "0xFF1E1F2B",   ; panel / card
        "raised",   "0xFF282A36",   ; Dracula bg -- rows, fields, tracks
        "raised2",  "0xFF343746",   ; hover, selected row
        "sunk",     "0xFF121319",   ; wells, list background
        ; structure
        "hair",     "0xFF3B3E52",   ; hairline rules, card borders
        "hairSoft", "0xFF2A2C3A",   ; grid lines, dividers inside a card
        ; ink
        "ink",      "0xFFF2F3F8",   ; primary text
        "inkDim",   "0xFFA6ACC8",   ; secondary text
        "inkMute",  "0xFF9A9FBE",   ; placeholders, disabled, helper text:
                                    ; >= 4.5:1 on every ground (4.54 on
                                    ; raised2) and still one step dimmer
                                    ; than inkDim, so the hierarchy holds
        ; ── NEON HOT PINK -- identity, selection, alarm ──────────────────
        "magenta",  "0xFFFF6FB5",   ; the signature hue
        "pink",     "0xFFFF9BCB",   ; lighter tint: warnings, soft accents
        "violet",   "0xFFFF2D95",   ; selection accent (kept as a name so
                                    ; call sites read the same)
        "latch",    "0xFFFF2D95",   ; a click lock is pink and unmissable
        "warn",     "0xFFFF6FB5",
        "danger",   "0xFFFF1B6B",   ; deeper, redder pink: destructive only
        ; ── BRIGHT OLIVE GREEN -- state: running, engaged, filled ────────
        "jade",     "0xFFBCD62B",   ; the state hue
        "teal",     "0xFF8FA61E",   ; deeper olive: gradient floor
        "seafoam",  "0xFFDCEB5A",   ; pale olive: gradient ceiling, knobs
        "ok",       "0xFFBCD62B",
        ; ── NEON CYAN -- information, focus, hover ───────────────────────
        "cyan",     "0xFF00E9FF",
        "cyanSoft", "0xFF7DF3FF",
        "sunset",   "0xFFFF6FB5")

    static Face := "Segoe UI"
    static Mono := "Consolas"
    ; body/small/tiny raised for legibility on a clinical display (WCAG
    ; accessibility pass, v0.6): +2 / +1 / +1 px. Checked against every
    ; fixed box height that text sits in (Chip 20-24, Btn 26-36, Field
    ; 30-32, List rowH 30, SELROW 28, Toast h=52) -- the smallest, Chip's
    ; 20 px with "tiny", still clears a 10 px line with headroom. hero/
    ; title/sub are left alone: their boxes (34/24/-) are already tight.
    static Size := Map("hero", 20, "title", 14, "sub", 12, "body", 13,
                       "small", 11, "tiny", 10)

    ; one spacing scale, no in-between values
    static SP  := Map("xs", 4, "sm", 8, "md", 12, "lg", 16, "xl", 24, "xxl", 32)
    ; Small radii on purpose. 14 px corners on every surface is the house
    ; style of every dashboard template on the internet; 3-4 px reads as an
    ; instrument panel and lets the hairlines do the work of separating things.
    static RAD := Map("card", 4, "row", 3, "field", 3, "chip", 2)
    ; toast duration raised 1600 -> 2600 ms: a reading-position or wheel
    ; confirmation needs longer than a click acknowledgement to actually read.
    static MS  := Map("hover", 140, "panel", 220, "toast", 2600)

    ; Dropdown geometry. SELMAX is only the FALLBACK window height, used when
    ; the monitor under the control cannot be resolved; normally __SelectOpen
    ; sizes the popup to the screen space actually available, so a 24-item
    ; action list opens whole. Anything still taller than the screen scrolls.
    static SELROW := 28
    static SELMAX := 14

    ; ── TOAST PLACEMENT ─────────────────────────────────────────────────────
    ; Where the HUD lands. It used to sit bottom-CENTRE of the primary
    ; monitor, and the plain-tooltip fallback sat AT THE CURSOR -- directly
    ; over the pixels being read. On a diagnostic display that is not a
    ; cosmetic complaint: a toast covering the region of interest is a toast
    ; covering the finding. It now parks in a corner, bottom-left by default,
    ; and RadMapper keeps these two in step with the config (AfterCfgChange).
    static toastCorner := "bl"        ; bl | br | tl | tr | bc
    static toastFollow := true        ; true = monitor under the cursor
    static TOASTPAD := 24             ; px clear of the work-area edges

    ; ── MODAL / POPUP BOOKKEEPING ───────────────────────────────────────────
    ; Every widget below is created into whatever layer is active AT THAT
    ; MOMENT and then has to keep working from a click that arrives much
    ; later, when the active layer is something else entirely. v0.3.6 read
    ; LayerStack.ActiveLayer at CLICK time instead, and both of the reported
    ; UI failures came straight out of that one mistake:
    ;
    ;   * a Field in the binding dialog was NOT EDITABLE. Its edit loop asked
    ;     "is my layer's window still in front?", got the MAIN window's hwnd
    ;     (the dialog restores ActiveLayer to its parent after building), saw
    ;     that the DIALOG was in front instead, concluded focus had moved and
    ;     exited on the first pass -- so every keystroke went nowhere.
    ;   * a Select in the dialog opened its option list AT MAIN-WINDOW
    ;     COORDINATES: the popup appeared somewhere over the mouse map,
    ;     detached from the control that opened it, and picking from it
    ;     redrew the main window while the dialog kept showing the old value.
    ;     Pick twice, and the second pick landed on whatever the main window
    ;     had put under the cursor -- assignments on unrelated buttons.
    ;
    ; The fix is ownership: a widget records its layer when it is BUILT
    ; (Lumi.Own) and never consults the global again.
    ;
    ; openSel holds THE open option list -- there is only ever one, as in
    ; every native combo box. A second one closes the first, a click anywhere
    ; else closes it (selWatch), and every teardown path calls CloseSelect.
    ; A list left floating after its owner was rebuilt was the other half of
    ; "random dropdowns show up and map unrelated buttons": it is a real
    ; top-level window with live handlers, and it outlived the state it
    ; wrote into.
    static openSel := 0
    static selWatch := 0
    static editing := 0            ; >0 while a Field owns the keyboard
    static liveField := 0          ; the Field currently capturing keys
    static editBeat := 0           ; heartbeat of the live edit loop

    /** The layer a widget is being built into, captured at construction. */
    static Own() {
        return LayerStack.ActiveLayer
    }

    /** The layer a shape belongs to, or 0. */
    static LayerOfShape(shp) {
        try {
            if (IsObject(shp) && shp.layerPtr)
                return ObjFromPtrAddRef(shp.layerPtr)
        }
        return 0
    }

    /** hwnd of a layer, or 0 -- a disposed layer must not throw. */
    static HwndOf(lyr) {
        try {
            if IsObject(lyr)
                return lyr.hwnd
        }
        return 0
    }

    /** True while the layer's window is the foreground window. */
    static LayerFront(lyr) {
        h := Lumi.HwndOf(lyr)
        if !h
            return false
        return WinActive("ahk_id " h) ? true : false
    }

    /**
     * Same object? -- by identity, never by value.
     *
     * `a = b` on two objects is a value comparison, and what it does with a
     * pair of objects (or an object against the 0 these slots hold when
     * empty) is not something to leave to interpretation in a file that
     * cannot be run here. ObjPtr is unambiguous.
     */
    static Same(a, b) {
        if (!IsObject(a) || !IsObject(b))
            return false
        return ObjPtr(a) = ObjPtr(b)
    }

    /** Redraw a layer, tolerating one that has already been disposed. */
    static Refresh(lyr) {
        try {
            if IsObject(lyr)
                lyr.Draw()
        }
    }

    /** True while any modal-ish thing owns input: a popup or a live Field. */
    static Busy() {
        return (Lumi.editing > 0 || IsObject(Lumi.openSel))
    }

    /**
     * Un-pin a modal state that died with the thread holding it.
     *
     * An uncaught error in AutoHotkey kills the thread it happened in, and
     * a `finally` on the way out is not guaranteed to run. Lumi.editing is
     * held above zero for the length of a field edit, and EVERY rebuild in
     * the program is deferred while it is -- so a single dead thread left
     * the settings window frozen: still showing its last frame, no longer
     * repainting, and not fixed by closing and reopening it, because the
     * window is hidden rather than destroyed.
     *
     * The edit loop stamps a heartbeat on every pass. A count that is up
     * while the heartbeat has gone cold is a count nobody is going to
     * decrement, so this drops it. Cheap enough to call from every tick.
     */
    static EditGuard() {
        if (Lumi.editing > 0) {
            d := A_TickCount - Lumi.editBeat
            if (d > 1500 || d < 0) {
                Lumi.editing := 0
                Lumi.liveField := 0
            }
        }
        ; The same for an option list whose window is already gone.
        if IsObject(Lumi.openSel) {
            alive := false
            try {
                pop := Lumi.openSel.pop
                if (IsObject(pop) && WinExist("ahk_id " pop.hwnd))
                    alive := true
            }
            if !alive
                Lumi.CloseSelect()
        }
    }

    /**
     * Force the next Draw of this layer to erase the WHOLE surface.
     *
     * GpGFX erases only the previous frame's bounding box, and that box is
     * the union of the shapes' declared rectangles -- while Text is
     * explicitly exempt from the clipping that would keep it inside its
     * own box. So a string longer than the width it was given paints
     * outside the erase region and is never cleaned up. Rebuild after
     * rebuild the overflow stacks: "the text is duplicated and slightly
     * offset, and nothing is clickable any more". The ghosts are pixels,
     * not shapes -- they take no clicks, and they cover the controls that
     * would.
     *
     * Widening the stored dirty rect to the whole layer makes that erase
     * cover everything. UpdateLayeredWindow always pushes the full surface,
     * so there is nothing else that needs widening to match.
     */
    static FullErase(lyr) {
        try {
            lyr.x1 := 0
            lyr.y1 := 0
            lyr.width := lyr.w
            lyr.height := lyr.h
        }
    }

    /**
     * A field's CURRENT text -- the live edit buffer while it is being
     * typed into, its committed value otherwise.
     *
     * Reading state.value directly is wrong and was a real data-loss bug:
     * the edit loop blocks on Sleep, which yields, so clicking Save while
     * the caret is still in the Value field runs the Save handler NESTED
     * INSIDE that loop -- at which point state.value still holds the text
     * from before you typed anything. Every read of a Field goes through
     * here.
     */
    static FieldValue(state) {
        if (IsObject(state) && state.HasOwnProp("ctx") && IsObject(state.ctx))
            return state.ctx.buf
        return IsObject(state) ? state.value : ""
    }

    /**
     * End the live field edit, if any, and commit what has been typed.
     *
     * Anything that is about to take the keyboard for itself must call this
     * first: a second InputHook on top of the field's own would feed the
     * same keystrokes to both, so recording a combo while the caret was in
     * the Value field typed the combo INTO the field as well as recording
     * it.
     */
    static EndEdit() {
        st := Lumi.liveField
        if (IsObject(st) && st.HasOwnProp("ctx") && IsObject(st.ctx))
            st.ctx.done := true
    }

    ; ── COLOUR MATH ─────────────────────────────────────────────────────────

    /** "0xAARRGGBB" -> {a, r, g, b} */
    static Split(c) {
        v := Integer(c)
        return {a: (v >> 24) & 0xFF, r: (v >> 16) & 0xFF,
                g: (v >> 8) & 0xFF,  b: v & 0xFF}
    }

    static Join(a, r, g, b) {
        return Format("0x{:02X}{:02X}{:02X}{:02X}",
            Integer(Round(a)), Integer(Round(r)),
            Integer(Round(g)), Integer(Round(b)))
    }

    /** Linear blend; t = 0 -> c1, t = 1 -> c2. */
    static Mix(c1, c2, t) {
        t := Min(Max(t, 0), 1)
        a := Lumi.Split(c1)
        b := Lumi.Split(c2)
        return Lumi.Join(a.a + (b.a - a.a) * t, a.r + (b.r - a.r) * t,
                         a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t)
    }

    /** Same hue, new alpha (0-255) -- glows, washes, invisible hit targets. */
    static Alpha(c, alpha) {
        p := Lumi.Split(c)
        return Lumi.Join(alpha, p.r, p.g, p.b)
    }

    /**
     * Fully transparent, as the INTEGER zero.
     *
     * This is the one alpha-0 value GpGFX can represent. Color() treats any
     * integer in 0x000001..0x00FFFFFF as 24-bit RGB and promotes it to fully
     * opaque, so an "alpha 0" colour like 0x00F2F3F8 comes out as SOLID
     * #F2F3F8 -- near-white. Exactly zero is documented as preserved.
     *
     * That promotion is what whited out the first build: invisible hit
     * targets were given `HoverAlpha(24, 0)`, whose normal state is an
     * alpha-0 INTEGER, and every one of them painted opaque white over the
     * control beneath it. Invisible click zones are now `Container` shapes,
     * which are never drawn at all, and hover feedback lives on the visible
     * shape where it belongs.
     */
    static Clear() {
        return 0
    }

    static Col(name) {
        return Lumi.C.Has(name) ? Lumi.C[name] : Lumi.C["cyan"]
    }

    ; ── PRIMITIVES ──────────────────────────────────────────────────────────

    /**
     * NO GRADIENTS. There were two -- a pink-to-cyan "horizon" across the
     * window lid and the primary button, and an olive ramp inside every
     * meter. Both are removed, and this comment is here so they do not come
     * back: a multi-stop gradient on a 3 px strip is decoration that says
     * nothing, it is the single loudest tell of a generated interface, and
     * on this palette it turned two deliberate hues into a muddy third.
     *
     * Flat fills, hairlines and one accent per state do the same jobs with
     * less noise, and they stay legible at reading-room viewing distance.
     */

    /** A hairline rule -- the workhorse of the atlas language. */
    static Rule(x, y, w, col := "") {
        return Line(x, y, x + w, y, (col = "") ? Lumi.C["hair"] : col, 1)
    }

    /**
     * A surface. `tone` picks the elevation: surface (panel), raised (row,
     * field), sunk (well). The hairline border is what makes these very
     * close dark tones read as separate planes.
     */
    static Card(x, y, w, h, tone := "surface", radius := -1) {
        r := (radius < 0) ? Lumi.RAD["card"] : radius
        RoundedRectangle(x, y, w, h, r, Lumi.Col(tone), true)
        RoundedRectangle(x, y, w, h, r, Lumi.C["hair"], false)
        return {x: x, y: y, w: w, h: h}
    }

    /**
     * Text. `kind` binds a size and an ink level together, so call sites
     * never pick a size and a colour separately and drift apart.
     *   hero | title | section | body | dim | mute | mono | code | accent
     */
    static Label(x, y, w, str, kind := "body", alignH := "left", h := 20) {
        switch kind {
            case "hero":
                return Text(x, y, w, 34, str, Lumi.C["ink"], Lumi.Size["hero"],
                    Lumi.Face, "Bold").TextAlign(alignH, "middle")
            case "title":
                return Text(x, y, w, 24, str, Lumi.C["ink"], Lumi.Size["title"],
                    Lumi.Face, "Bold").TextAlign(alignH, "middle")
            case "section":
                return Text(x, y, w, 18, StrUpper(str), Lumi.C["inkMute"],
                    Lumi.Size["tiny"], Lumi.Face, "Bold").TextAlign(alignH, "middle")
            case "dim":
                return Text(x, y, w, h, str, Lumi.C["inkDim"], Lumi.Size["body"],
                    Lumi.Face).TextAlign(alignH, "middle")
            case "mute":
                return Text(x, y, w, h, str, Lumi.C["inkMute"], Lumi.Size["small"],
                    Lumi.Face).TextAlign(alignH, "middle")
            case "mono":
                return Text(x, y, w, h, str, Lumi.C["cyanSoft"], Lumi.Size["small"],
                    Lumi.Mono).TextAlign(alignH, "middle")
            case "code":
                return Text(x, y, w, h, str, Lumi.C["inkDim"], Lumi.Size["small"],
                    Lumi.Mono).TextAlign(alignH, "middle")
            case "accent":
                return Text(x, y, w, h, str, Lumi.C["cyan"], Lumi.Size["body"],
                    Lumi.Face, "Bold").TextAlign(alignH, "middle")
            default:
                return Text(x, y, w, h, str, Lumi.C["ink"], Lumi.Size["body"],
                    Lumi.Face).TextAlign(alignH, "middle")
        }
    }

    /** A wrapping paragraph -- GpGFX wraps inside the shape's box. */
    static Para(x, y, w, h, str, kind := "dim") {
        col := (kind = "mute") ? Lumi.C["inkMute"] : Lumi.C["inkDim"]
        return Text(x, y, w, h, str, col, Lumi.Size["small"], Lumi.Face)
            .TextAlign("left", "top")
    }

    ; ── CONTROLS ────────────────────────────────────────────────────────────

    /**
     * Button, four weights. Only ONE primary belongs on a screen:
     *   primary -- hot pink horizon fill, the single committing action
     *   accent  -- cyan outline, common non-destructive actions
     *   ghost   -- raised fill, everything else
     *   danger  -- red outline, delete
     *
     * The hit target is always a transparent rect created LAST, so it sits
     * on top for hit-testing (GpGFX tests shapes in reverse draw order) and
     * the label underneath is never dimmed by the hover wash.
     */
    static Btn(x, y, w, h, label, onClick := 0, kind := "ghost") {
        r := Lumi.RAD["field"]
        switch kind {
            case "primary":
                ; flat pink, dark label. One per screen, and the only
                ; saturated fill anywhere -- which is what makes it read as
                ; the primary action without a glow or a gradient.
                hit := RoundedRectangle(x, y, w, h, r, Lumi.C["magenta"], true)
                Text(x, y, w, h, label, Lumi.C["abyss"], Lumi.Size["body"],
                    Lumi.Face, "Bold").TextAlign("center", "middle")
                hit.Hover(Lumi.C["pink"], Lumi.C["magenta"])
            case "accent":
                hit := RoundedRectangle(x, y, w, h, r, Lumi.C["raised"], true)
                RoundedRectangle(x, y, w, h, r, Lumi.C["cyan"], false)
                Text(x, y, w, h, label, Lumi.C["cyanSoft"], Lumi.Size["body"],
                    Lumi.Face, "Bold").TextAlign("center", "middle")
                hit.Hover(Lumi.C["raised2"], Lumi.C["raised"])
            case "danger":
                hit := RoundedRectangle(x, y, w, h, r, Lumi.C["raised"], true)
                RoundedRectangle(x, y, w, h, r, Lumi.C["danger"], false)
                Text(x, y, w, h, label, Lumi.C["danger"], Lumi.Size["body"],
                    Lumi.Face, "Bold").TextAlign("center", "middle")
                hit.Hover(Lumi.C["raised2"], Lumi.C["raised"])
            default:
                hit := RoundedRectangle(x, y, w, h, r, Lumi.C["raised"], true)
                RoundedRectangle(x, y, w, h, r, Lumi.C["hair"], false)
                Lumi.Label(x, y, w, label, "dim", "center", h)
                hit.Hover(Lumi.C["raised2"], Lumi.C["raised"])
        }
        if (onClick != 0)
            hit.OnEvent("Click", onClick)
        return hit
    }

    /**
     * Status mark: a 2 px rule in the hue, and the label in that same hue,
     * set in mono. No pill, no translucent wash, no border.
     *
     * The pill version was the second-loudest generic tell in the first
     * pass -- six softly-glowing capsules across a header is a dashboard
     * mockup, not a status line. A rule plus a word carries the same
     * information at a fraction of the ink.
     */
    static Chip(x, y, w, h, label, tone := "cyan") {
        col := Lumi.Col(tone)
        Rectangle(x, y + 3, 2, h - 6, col, true)
        return Text(x + 8, y, w - 8, h, StrUpper(label), col, Lumi.Size["tiny"],
            Lumi.Mono).TextAlign("left", "middle")
    }

    /**
     * Toggle switch. Olive when on (olive = state), inert grey when off.
     * onChange(newValue) runs after the visual has already flipped.
     */
    ; default hit target raised 44x22 -> 52x28 (WCAG pass: 22 px was below
    ; the 28 px floor for an interactive target). Explicit w/h passed by a
    ; caller (e.g. the modifier toggles in the key-recorder) are untouched.
    static Toggle(x, y, label, value, onChange := 0, w := 52, h := 28) {
        track := RoundedRectangle(x, y, w, h, Lumi.RAD["field"],
            value ? Lumi.C["teal"] : Lumi.C["raised"], true)
        edge := RoundedRectangle(x, y, w, h, Lumi.RAD["field"],
            value ? Lumi.C["jade"] : Lumi.C["hair"], false)
        knob := RoundedRectangle(value ? (x + w - h + 3) : (x + 3), y + 3,
            h - 6, h - 6, 2,
            value ? Lumi.C["jade"] : Lumi.C["inkMute"], true)
        if (label != "")
            Lumi.Label(x + w + Lumi.SP["md"], y, 340, label, "dim", "left", h)
        state := {value: value, x: x, w: w, h: h,
                  track: track, edge: edge, knob: knob, onChange: onChange}
        ; both visible parts take the click; neither needs an overlay
        track.OnEvent("Click", ObjBindMethod(Lumi, "__ToggleFlip", state))
        knob.OnEvent("Click", ObjBindMethod(Lumi, "__ToggleFlip", state))
        return state
    }

    static __ToggleFlip(state, *) {
        state.value := !state.value
        state.track.colour := state.value ? Lumi.C["teal"] : Lumi.C["raised"]
        state.edge.colour := state.value ? Lumi.C["jade"] : Lumi.C["hair"]
        state.knob.colour := state.value ? Lumi.C["jade"] : Lumi.C["inkMute"]
        state.knob.x := state.value
            ? (state.x + state.w - state.h + 3) : (state.x + 3)
        state.track.RedrawLayer()
        if (state.onChange != 0)
            (state.onChange)(state.value)
    }

    /**
     * Slider with an olive fill, a mono readout, and atlas tick marks.
     * The grab target is a full-height invisible strip -- a 4 px track is
     * impossible to hit. Dragging is MouseMove while LButton is physically
     * down, which needs no capture and cannot get stuck.
     */
    static Slider(x, y, w, minV, maxV, value, onChange := 0, h := 20) {
        ty := y + h // 2 - 2
        Rectangle(x, ty, w, 4, Lumi.C["raised"], true)
        span := Max(maxV - minV, 1)
        frac := (value - minV) / span
        fill := Rectangle(x, ty, Round(w * frac), 4, Lumi.C["jade"], true)
        knob := RoundedRectangle(Round(x + w * frac) - 5, y + h // 2 - 7,
            10, 14, 2, Lumi.C["jade"], true)
        readout := Lumi.Label(x + w + Lumi.SP["md"], y, 52, String(value), "mono")
        i := minV
        while (i <= maxV) {
            tx := Round(x + w * ((i - minV) / span))
            Line(tx, y + h // 2 + 8, tx, y + h // 2 + 11,
                Lumi.Alpha(Lumi.C["inkMute"], 120), 1)
            i += 1
        }
        state := {value: value, x: x, w: w, y: y, h: h, min: minV, max: maxV,
                  span: span, fill: fill, knob: knob, readout: readout,
                  onChange: onChange}
        strip := Container(x - 8, y, w + 16, h)   ; never drawn, only hit-tested
        strip.OnEvent("LeftMouseDown", ObjBindMethod(Lumi, "__SliderDrag", state, false))
        strip.OnEvent("MouseMove", ObjBindMethod(Lumi, "__SliderDrag", state, true))
        return state
    }

    static __SliderDrag(state, needButton, shp, mx, my) {
        if (needButton && !GetKeyState("LButton", "P"))
            return
        f := Min(Max((mx - state.x) / state.w, 0), 1)
        v := Round(state.min + f * state.span)
        if (v = state.value)
            return
        state.value := v
        f := (v - state.min) / state.span
        state.fill.w := Round(state.w * f)
        state.knob.x := Round(state.x + state.w * f) - 5
        state.readout.Text(String(v), Lumi.C["cyanSoft"], Lumi.Size["small"],
            Lumi.Mono, , , "left", "middle")
        state.fill.RedrawLayer()
        if (state.onChange != 0)
            (state.onChange)(v)
    }

    /** Read-only bar: flat olive fill in a flat well. */
    static Meter(x, y, w, h, frac, tone := "") {
        Rectangle(x, y, w, h, Lumi.C["sunk"], true)
