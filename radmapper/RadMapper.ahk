    /**
     * Ask before something cannot be undone.
     *
     * The tick is STOPPED across the question: MsgBox blocks this thread,
     * the 700 ms status tick does not stop for it, and a Build() landing
     * mid-question disposes the very shape whose click handler is sitting
     * here waiting for an answer. Owned by the settings window so it cannot
     * open behind it -- the window is deliberately not top-most.
     */
    static Confirm(msg) {
        Lumi.CloseSelect()
        Lumi.EndEdit()
        Atlas.StopTick()
        ans := "No"
        try {
            own := ""
            if (IsObject(Atlas.lyr) && Atlas.lyr.hwnd)
                own := " Owner" Atlas.lyr.hwnd
            ans := MsgBox(msg, "RadMapper", "YesNo Icon?" own)
        }
        Atlas.StartTick()
        return (ans = "Yes")
    }

    /**
     * A hotkey written the way it is said out loud: "^!+F9" -> "Ctrl + Alt +
     * Shift + F9". The stored string is AutoHotkey syntax and stays that way
     * in the config and in the Settings fields; this is for the Home panel,
     * where the reader has never seen that syntax and never should.
     */
    static HkWords(key) {
        raw := Trim(String(Cfg(key)))
        if (raw = "")
            return "not set"
        out := ""
        rest := raw
        while (rest != "") {
            c := SubStr(rest, 1, 1)
            if (c = "^")
                out .= "Ctrl + "
            else if (c = "!")
                out .= "Alt + "
            else if (c = "+")
                out .= "Shift + "
            else if (c = "#")
                out .= "Win + "
            else
                break
            rest := SubStr(rest, 2)
        }
        return out . rest
    }

    static NavGo(i) {
        return (*) => Atlas.Go(i)
    }

    /**
     * Build a dialog under a guard. EVERY dialog goes through this.
     *
     * A dialog builder sets LayerStack.ActiveLayer to its own layer and
     * restores nothing, because on success the dialog IS the layer new
     * shapes belong to. Every shape constructor reads that one global -- so
     * a throw part-way through a build leaves it pointing at a layer that
     * was never drawn, and from then on:
     *
     *   * Lumi.Own() captures that dead layer as the OWNER of every field
     *     built afterwards, and Lumi.__FieldMine compares the owner's hwnd
     *     against the foreground window. It never matches, so the edit loop
     *     exits before the first keystroke and TYPING DOES NOTHING. That is
     *     the "normal letters would not output" report, exactly.
     *   * Atlas.dlg is set, so the status tick returns early forever and the
     *     main window stops repainting.
     *   * the half-built dialog window is real, on top, and NOT
     *     click-through, so it silently eats clicks aimed at the window
     *     underneath.
     *
     * Three separate ways for one uncaught error to look like "the app
     * froze". The finally clause below is the whole fix; the catch is so the
     * error is named instead of vanishing into the shape dispatch's bare try.
     */
    static OpenDlg(fn) {
        prev := LayerStack.ActiveLayer
        try {
            fn()
        } catch as e {
            Problem("ui", "dialog build failed: " e.Message
                . (e.HasProp("Line") ? " (line " e.Line ")" : ""))
            if IsObject(Atlas.dlg) {
                Atlas.Disown(Atlas.dlg)
                try Atlas.dlg.Dispose()
                Atlas.dlg := 0
            }
            Atlas.dstate := 0
            Lumi.Toast("That dialog could not be built — see Diagnostics",
                "danger", 4000)
        } finally {
            ; Whatever happened, the construction target must be a layer that
            ; is actually on screen: the dialog if one opened, otherwise the
            ; main window.
            if IsObject(Atlas.dlg)
                LayerStack.ActiveLayer := Atlas.dlg
            else if IsObject(Atlas.lyr)
                LayerStack.ActiveLayer := Atlas.lyr
            else if IsObject(prev)
                LayerStack.ActiveLayer := prev
        }
    }

    static Go(i) {
        ; A PanelIndex() miss returns 0, and 0 would draw a window with a
        ; header, a nav and an empty body. Refuse it and stay where we are.
        if (i < 1 || i > Atlas.PANELS.Length)
            return
        Atlas.panel := i
        Atlas.Build()
    }

