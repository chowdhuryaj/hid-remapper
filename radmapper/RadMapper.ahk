            cx += c.w
            ci += 1
        }
    }

    /** Factories -- one closure per row, capturing idx by VALUE. */
    static __ListPick(view, idx, dbl) {
        return (*) => Lumi.__ListDo(view, idx, dbl)
    }

    static __ListWheel(view, delta) {
        return (*) => Lumi.__ListScroll(view, delta)
    }

    static __ListDo(view, idx, dbl) {
        view.sel := idx
        Lumi.__ListPaint(view)
        if IsObject(view.layer)
            view.layer.Draw()
        if (view.onPick != 0)
            (view.onPick)(idx, dbl)
    }

    ; ── TOAST / HUD ─────────────────────────────────────────────────────────
    ; One reusable layer, click-through and non-activating, so it can never
    ; steal a click or the foreground from whatever is underneath.

    static _toast := 0

    static Toast(msg, tone := "cyan", ms := 0) {
        if (ms = 0)
            ms := Lumi.MS["toast"]
        col := Lumi.Col(tone)
        prev := LayerStack.ActiveLayer
        try {
            if IsObject(Lumi._toast) {
                try Lumi._toast.Dispose()
                Lumi._toast := 0
            }
            w := Min(Max(StrLen(msg) * 8 + 64, 240), 760)
            h := 52
            lyr := Layer(w, h, "LumiToast")
            LayerStack.ActiveLayer := lyr
            Lumi.Card(0, 0, w, h, "surface")
            Rectangle(0, 0, 3, h, col, true)              ; the whole signal
            Lumi.Label(18, 0, w - 30, msg, "body", "left", h)
            Lumi.__ToastPlace(lyr)
            lyr.ClickThrough := true
            lyr.NoActivate()
            lyr.Draw(-ms)
            Lumi._toast := lyr
        }
        if IsObject(prev)
            LayerStack.ActiveLayer := prev
    }

    /**
     * Park the toast in a corner of the WORK AREA -- never under the cursor,
     * never over the middle of an image. Bottom-left by default.
     *
     * The monitor is the one under the pointer when toastFollow is on, so
     * the HUD appears on the display being worked rather than on whichever
     * screen Windows calls primary. Work area, not monitor bounds, so the
     * corner is not behind the taskbar.
     */
    static __ToastPlace(lyr) {
        try {
            if Lumi.toastFollow {
                MouseGetPos(&cx, &cy)
                m := MonitorWorkAt(cx, cy)
            } else {
                MonitorGetWorkArea(MonitorGetPrimary(), &pl, &pt, &pr, &pb)
                m := {l: pl, t: pt, r: pr, b: pb}
            }
            p := Lumi.TOASTPAD
            switch Lumi.toastCorner {
                case "br": x := m.r - lyr.w - p, y := m.b - lyr.h - p
                case "tl": x := m.l + p,          y := m.t + p
                case "tr": x := m.r - lyr.w - p, y := m.t + p
                case "bc": x := m.l + (m.r - m.l - lyr.w) // 2,
                           y := m.b - lyr.h - p
                default:   x := m.l + p,          y := m.b - lyr.h - p
            }
            lyr.Move(x, y)
            return
        }
        lyr.Center()
    }

    ; ── GALLERY (self-test) ─────────────────────────────────────────────────
    ; What this is, since the question was fair: it is a RENDERING AND INPUT
    ; SELF-TEST, not a settings screen. It writes nothing to your config and
    ; changes nothing about how the engine behaves. Its job is to answer one
    ; question on a machine you have not run RadMapper on before -- does the
    ; graphics stack actually work here, and does this window receive clicks,
    ; hover, wheel and keystrokes? If a widget renders wrong or goes dead
    ; here, it renders wrong or goes dead everywhere, and it is one screen to
    ; look at instead of eight panels.
    ;
    ; It used to be a poster: everything drawn, nothing to interact with
    ; beyond a few toasts, no way out except killing the script -- it was not
    ; draggable, it had no close button, and the line telling you Escape
    ; closes it was decoration, because nothing ever bound Escape. All three
    ; are fixed, and every control now reports into a live event log on the
    ; right, which is the part that makes it a test rather than a picture:
    ; you can see that the click you just made was received, decoded to the
    ; right widget, and carried the right value.

    static galleryLyr := 0
    static galleryLog := []
    static galleryRows := []
    static galleryEsc := false
    static GALLOG := 10

    static Gallery() {
        if IsObject(Lumi.galleryLyr) {
            try {
                Lumi.galleryLyr.Show()
                Lumi.galleryLyr.Activate()
            }
            return Lumi.galleryLyr
        }
        w := 1000
        h := 820
        prev := LayerStack.ActiveLayer
        lyr := Layer(w, h, "LumiAtlasGallery")
        Lumi.galleryLyr := lyr
        Lumi.galleryLog := []
        Lumi.galleryRows := []
        LayerStack.ActiveLayer := lyr
        lyr.Center()
        lyr.TopMost(false)
        lyr.Drag()                       ; borderless: every bare surface is a caption
        try Atlas.Own(lyr)               ; our window -- the engine must not remap into it
        Lumi.GalleryBindEsc()

        Lumi.Card(0, 0, w, h, "abyss", 0)
        Lumi.Rule(0, 3, w, Lumi.C["hair"])

        Lumi.Label(28, 20, 500, "Lumi Atlas", "hero")
        Lumi.Label(28, 54, 660,
            "Rendering and input self-test — this screen changes nothing", "dim")
        Lumi.Chip(w - 300, 30, 140, 24, "widget kit", "magenta")
        Lumi.Btn(w - 60, 22, 32, 26, "X", (*) => Lumi.GalleryClose(), "ghost")
        Lumi.Rule(28, 92, w - 56)

        ; --- palette ---
        Lumi.Label(28, 100, 300, "Palette", "section")
        sx := 28
        for name in ["abyss", "surface", "raised", "raised2", "hair", "ink",
                     "inkDim", "magenta", "pink", "danger", "jade", "teal",
                     "seafoam", "cyan", "cyanSoft"] {
            RoundedRectangle(sx, 124, 56, 40, 8, Lumi.C[name], true)
            RoundedRectangle(sx, 124, 56, 40, 8, Lumi.C["hair"], false)
            Lumi.Label(sx - 4, 166, 64, name, "mute", "center")
            sx += 62
        }
        Lumi.Label(28, 192, 400, "Flat fills — no gradients anywhere", "section")
        i := 0
        for name in ["magenta", "pink", "danger", "jade", "teal", "cyan"] {
            Rectangle(28 + i * 74, 214, 66, 10, Lumi.C[name], true)
            i += 1
        }

        ; --- controls ---
        Lumi.Label(28, 244, 300, "Controls", "section")
        Lumi.Btn(28, 266, 118, 34, "Primary",
            (*) => Lumi.GalleryNote("Btn primary", "magenta"), "primary")
        Lumi.Btn(156, 266, 118, 34, "Accent",
            (*) => Lumi.GalleryNote("Btn accent", "cyan"), "accent")
        Lumi.Btn(284, 266, 118, 34, "Ghost",
            (*) => Lumi.GalleryNote("Btn ghost", "violet"), "ghost")
        Lumi.Btn(412, 266, 118, 34, "Delete",
            (*) => Lumi.GalleryNote("Btn danger", "danger"), "danger")

        Lumi.Toggle(28, 320, "Toggle A", true,
            (v) => Lumi.GalleryNote("Toggle A -> " (v ? "on" : "off"),
                v ? "jade" : "inkMute"))
        Lumi.Toggle(300, 320, "Toggle B", false,
            (v) => Lumi.GalleryNote("Toggle B -> " (v ? "on" : "off"),
                v ? "jade" : "inkMute"))

        Lumi.Label(28, 356, 300, "Slider — drag it", "mute")
        Lumi.Slider(28, 378, 300, 1, 20, 3,
            (v) => Lumi.GalleryNote("Slider = " v, "jade"))

        Lumi.Label(28, 420, 300, "Field  /  select", "section")
        Lumi.Field(28, 442, 214, 32, "",
            (t) => Lumi.GalleryNote("Field committed: " t, "jade"),
            "click and type...")
        Lumi.Select(256, 442, 200, 32,
            ["Global (all apps)", "PACS", "PowerScribe"], 2,
            (i, t) => Lumi.GalleryNote("Select -> " t, "violet"))
        Lumi.Field(470, 442, 160, 32, "Numpad1", 0, "", true)

        Lumi.Label(28, 488, 300, "Meters  /  chips", "section")
        Lumi.Meter(28, 512, 300, 10, 0.72)
        Lumi.Meter(28, 530, 300, 10, 0.31)
        Lumi.Chip(348, 506, 96, 22, "RUNNING", "jade")
        Lumi.Chip(348, 534, 96, 22, "LOCK: LMB", "magenta")
        Lumi.Chip(452, 506, 96, 22, "PACS", "cyan")
        Lumi.Chip(452, 534, 96, 22, "PAUSED", "pink")

        ; --- list ---
        Lumi.Label(566, 244, 300, "List", "section")
        rows := []
        for r in [["X1 Back", "tap", "Teleport monitor: prev"],
                  ["X2 Fwd", "tap", "Teleport monitor: next"],
                  ["Numpad1", "tap", "Send keys: {Enter}"],
                  ["Numpad2", "tap", "Send keys: {Tab}"],
                  ["Numpad3", "tap", "Send keys: {Esc}"],
                  ["Numpad5", "tap", "PowerScribe: next field"],
                  ["Numpad8", "tap", "PowerScribe: previous field"],
                  ["NumpadSub", "tap", "Send keys: {Delete}"],
                  ["]", "tap", "Send keys: ^c"],
                  ["]", "hold", "Send keys: ^x"],
                  ["[", "tap", "Send keys: ^v"],
                  ["Wheel Up", "turn", "Native scroll"]]
            rows.Push({cells: r})
        Lumi.List(566, 266, 406, 300, rows,
            [{w: 100, kind: "mono"}, {w: 62, kind: "mute"}, {w: 216}],
            (i, dbl) => Lumi.GalleryNote((dbl ? "List opened row " : "List selected row ") i,
                dbl ? "magenta" : "cyan"),
            30, ["Input", "Trigger", "Action"])
        Lumi.Label(566, 570, 406,
            "Wheel scrolls. Click selects, double-click opens.", "mute")

        ; --- live event log ---
        ; The log rows are created ONCE and only ever have their text
        ; rewritten (Lumi.GalleryNote). They are never rebuilt: a note is
        ; raised from inside a widget's own click handler, and clearing the
        ; layer there would dispose the very shape whose handler is running.
        Lumi.Label(566, 596, 300, "Event log", "section")
        Lumi.Card(566, 618, 406, 176)
        i := 0
        while (i < Lumi.GALLOG) {
            Lumi.galleryRows.Push(
                Text(582, 630 + i * 16, 380, 16, "", Lumi.C["inkMute"],
                    Lumi.Size["small"], Lumi.Mono).TextAlign("left", "middle"))
            i += 1
        }

        Lumi.Rule(28, h - 56, w - 56)
        Lumi.Label(28, h - 46, 820,
            "Escape or X closes this. Drag it by any bare surface. Nothing "
            . "here is written to your config.", "mute")

        lyr.Draw()
        lyr.Activate()
        Lumi.GalleryNote("self-test ready", "cyan")
        if (IsObject(prev) && !Lumi.Same(prev, lyr))
            LayerStack.ActiveLayer := prev
        return lyr
    }

    /**
     * Append to the log and repaint just those ten Text shapes.
     *
     * Newest last, so it reads like a transcript. The colour is carried per
     * row so a danger action is visibly a danger action -- which is half of
     * what makes this a test of the PALETTE and not only of dispatch.
     */
    static GalleryNote(msg, tone := "cyan") {
        if !IsObject(Lumi.galleryLyr)
            return
        Lumi.galleryLog.Push({t: FormatTime(, "HH:mm:ss"), m: msg, c: tone})
        while (Lumi.galleryLog.Length > Lumi.GALLOG)
            Lumi.galleryLog.RemoveAt(1)
        i := 1
        for shp in Lumi.galleryRows {
            if (i <= Lumi.galleryLog.Length) {
                e := Lumi.galleryLog[i]
                shp.Text(e.t "  " e.m, Lumi.Col(e.c), Lumi.Size["small"],
                    Lumi.Mono, , , "left", "middle")
            } else {
                shp.Text("", Lumi.C["inkMute"], Lumi.Size["small"],
                    Lumi.Mono, , , "left", "middle")
            }
            i += 1
        }
        try Lumi.galleryLyr.Draw()
    }

    /**
     * Escape, bound ONCE and scoped to the gallery's own window, so it stays
     * completely native everywhere else -- the same contract Atlas.BindEscape
     * keeps for the main window.
     */
    static GalleryBindEsc() {
        if Lumi.galleryEsc
            return
        try {
            HotIf(ObjBindMethod(Lumi, "__GalleryFront"))
            Hotkey("Escape", ObjBindMethod(Lumi, "__GalleryEsc"), "On")
            HotIf()
            Lumi.galleryEsc := true
        }
    }

    static __GalleryFront(*) {
        if !IsObject(Lumi.galleryLyr)
            return 0
        try
            return WinActive("ahk_id " Lumi.galleryLyr.hwnd) ? 1 : 0
        return 0
    }

    static __GalleryEsc(*) {
        if IsObject(Lumi.openSel) {
            Lumi.CloseSelect()
            return
        }
        Lumi.GalleryClose()
    }

    static GalleryClose(*) {
        Lumi.CloseSelect()
        Lumi.EndEdit()
        if IsObject(Lumi.galleryLyr) {
            try Atlas.Disown(Lumi.galleryLyr)
            try Lumi.galleryLyr.Dispose()
        }
        Lumi.galleryLyr := 0
        Lumi.galleryRows := []
        Lumi.galleryLog := []
    }
}


; ══════════════════════════════════════════════════════════════════════════════
;  §14  BUNDLED: the Lumi Atlas front-end
; ══════════════════════════════════════════════════════════════════════════════

;==============================================================================
;  RadMapperUI.ahk  --  RadMapper's settings window, drawn in Lumi Atlas
;------------------------------------------------------------------------------
;  A full GpGFX front-end: the window, the nav, every panel, the mouse map and
;  the binding editor are vector shapes on layered windows. There is not a
;  single Win32 child control here.
;
;  It is a PRESENTATION layer only. Every read goes to RadMapper's existing
;  config (g_Cfg) and helpers (InputLabel, DescribeAction, AppChoices,
;  LayerChoices, ACT_LABELS...), and every write goes through the same
;  mutators the classic GUI used (SaveCfg, AfterCfgChange, UpsertBinding).
;  The engine cannot tell which front-end is driving it.
;
;  LOAD ORDER: this is a single-file build -- the engine (§1-§12), the design
;  system (§13), this front-end (§14) and GpGFX itself (§15) are all in one
;  script, in that order. Classes and functions are hoisted, so the ordering
;  matters only for the positional #Warn directive GpGFX carries.
;
;  ENGINE SAFETY -- two rules this file must never break:
;    1. Every layer it creates is registered in g_OurHwnds, or the engine
;       will treat its own settings window as a foreign app and remap the
;       keys you are typing into it.
;    2. The toast/HUD layer is click-through and non-activating, and is
;       excluded from the positional "is this ours" test, or it would eat
;       clicks aimed at whatever sits beneath the cursor.
;==============================================================================


class Atlas {

    static W := 1120
    static H := 720
    ; The window SHRINKS as well as grows (v0.4.7). It used to bottom out at
    ; the design size, because Settings and Pointer were laid out on absolute
    ; offsets that assumed one height -- so "make it smaller" did nothing and
    ; read as a broken grip. Those two now allocate elastic bands
    ; (Atlas.Bands) and derive every column from w, and the rest of the panels
    ; were already height-relative. The floor below is where the hotkey card
    ; can still hold two columns and the timing rows are still legible.
    static MINW := 940
    static MINH := 640
    static maxed := false
    static restore := 0            ; pre-maximise rect
    static resizing := false
    static NAVW := 188
    static HEADH := 64

    static lyr := 0                ; main window layer
    static panel := 1              ; active panel index
    static sel := "LButton"        ; selected input in the mouse map
    static keySel := ""            ; selected key in the Keyboard panel
    static kbAppIdx := 1           ; Keyboard panel App scope
    static kbLayerIdx := 1         ; Keyboard panel Layer scope
    static appIdx := 1             ; App scope selector
    static layerIdx := 1           ; Layer scope selector
    static list := 0               ; the active list view handle
    static rowRefs := []           ; list row -> g_Cfg["bindings"] index
    static ticking := false
    static timerFn := 0
    static savedSel := 0           ; list selection, preserved across rebuilds
    static parkRef := 0            ; app row awaiting a park-spot capture
    static escBound := false
    static pending := false        ; a rebuild deferred past a live edit
    static pendAt := 0             ; ... since this tick; deferral is capped
    static resizeMode := "both"   ; right | bottom | both
    static resizeStartX := 0       ; screen-space anchor captured on mouse-down
    static resizeStartY := 0

    ; "Layers" are HOLD layers (an input arming a set of rows); "Windows"
    ; are window LAYOUTS across the monitors. Different things, and the nav
    ; is the one place the two words sit next to each other.
    ; "Home" is FIRST and is where the window opens (static panel := 1),
    ; because the people this ships to have not read any of the above.
    ; NOTHING may hard-code a number out of this list: use PanelIndex().
    static PANELS := ["Home", "Mouse", "Layers", "Keyboard", "Macros", "Apps",
                      "Windows", "Menus", "Pointer", "Settings", "Diagnostics"]
    static hostRefs := []          ; Layers panel row -> host input code

    ; ── WINDOW ──────────────────────────────────────────────────────────────

    static Show() {
        if IsObject(Atlas.lyr) {
            ; Minimised is not the same as hidden: Show() alone leaves a
            ; minimised window minimised, so the tray icon would appear to do
            ; nothing once you had used the minimise button.
            try {
                if (WinGetMinMax("ahk_id " Atlas.lyr.hwnd) = -1)
                    WinRestore("ahk_id " Atlas.lyr.hwnd)
            }
            Atlas.lyr.Show()
            Atlas.lyr.Activate()
            ; Closing and reopening has to be a REPAIR: the window is hidden
            ; rather than destroyed, so whatever state stopped it repainting
            ; would otherwise still be there when it came back.
            Lumi.EditGuard()
            Atlas.pending := false
            Atlas.lastSig := ""
            Atlas.Build()
            Atlas.StartTick()
            return
        }
        ; A size remembered from last session, clamped to the design minimum
        ; and to the monitor -- a window restored larger than the screen it
        ; lands on cannot be grabbed by its own grip.
        MonitorGetWorkArea(MonitorGetPrimary(), &wl, &wt, &wr, &wb)
        Atlas.W := ClampInt(Cfg("winW"), Atlas.MINW,
            Max(Atlas.MINW, wr - wl), Atlas.MINW)
        Atlas.H := ClampInt(Cfg("winH"), Atlas.MINH,
            Max(Atlas.MINH, wb - wt), Atlas.MINH)
        Atlas.maxed := Cfg("winMax") ? true : false
        lyr := Layer(Atlas.W, Atlas.H, "RadMapper")
        Atlas.lyr := lyr
        LayerStack.ActiveLayer := lyr
        lyr.Center()
        lyr.TopMost(false)              ; never float over PACS
        Atlas.Own(lyr)
        lyr.Drag()                      ; drag the window by any bare surface
        Atlas.AppWindow(lyr)            ; taskbar + Alt+Tab, before the first Build
        Atlas.BindEscape()
        Atlas.Build()
        lyr.Activate()
        Atlas.StartTick()
    }

    /**
     * Escape closes the window, as it did in the classic GUI. Registered
     * ONCE, under a context that is true only while our own layer is the
     * foreground window, so Escape stays completely native everywhere else.
     */
    static BindEscape() {
        if Atlas.escBound
            return
        try {
            HotIf(ObjBindMethod(Atlas, "IsFront"))
            Hotkey("Escape", ObjBindMethod(Atlas, "EscKey"), "On")
            Hotkey("F1", (*) => Atlas.Help(), "On")
            ; Resize from the keyboard, live only while OUR window is in
            ; front, so these four combos stay completely native everywhere
            ; else. Ctrl+Alt+arrow rather than plain arrow: a settings window
            ; must not eat the arrow keys.
            Hotkey("^!Left",  (*) => Atlas.SizeNudge(-40, 0), "On")
            Hotkey("^!Right", (*) => Atlas.SizeNudge(40, 0), "On")
            Hotkey("^!Up",    (*) => Atlas.SizeNudge(0, -40), "On")
            Hotkey("^!Down",  (*) => Atlas.SizeNudge(0, 40), "On")
            HotIf()
            Atlas.escBound := true
        }
    }

    /**
     * Escape unwinds ONE level: the open option list, then the binding
     * dialog, then the window. Escape used to close the whole window from
     * anywhere, which meant a half-typed binding took the settings window
     * with it -- and while the dialog was up Escape did nothing at all,
     * because the context test only ever looked at the main layer.
     */
    static EscKey(*) {
        if IsObject(Lumi.openSel) {
            Lumi.CloseSelect()
            return
        }
        if IsObject(Atlas.dlg) {
            Atlas.CloseDlg()
            return
        }
        Atlas.Hide()
    }

    static IsFront(*) {
        try {
            if (IsObject(Atlas.dlg) && WinActive("ahk_id " Atlas.dlg.hwnd))
                return 1
        }
        if !IsObject(Atlas.lyr)
            return 0
        return WinActive("ahk_id " Atlas.lyr.hwnd) ? 1 : 0
    }

    static Hide(*) {
        Atlas.StopTick()
        Lumi.CloseSelect()               ; a floating option list must never
        if IsObject(Atlas.dlg) {         ; outlive the window that opened it
            Atlas.Disown(Atlas.dlg)
            try Atlas.dlg.Dispose()
            Atlas.dlg := 0
        }
        if IsObject(Atlas.lyr)
            Atlas.lyr.Hide()
    }

    /**
     * Register a layer as one of OUR windows. The engine's own-window tests
     * key off g_OurHwnds (foreground) and process identity (positional), so
     * a layer that skips this becomes a foreign app the engine will happily
     * remap keys into -- while you are typing in it.
     */
    static Own(lyr) {
        global g_OurHwnds
        try {
            g_OurHwnds[lyr.hwnd] := 1
            ; Text is intentionally not clipped by GpGFX, so dirty-rectangle
            ; erasure is unsafe for any RadMapper window that rebuilds.
            lyr.alwaysFullErase := true
        }
    }

    static Disown(lyr) {
        global g_OurHwnds
        try {
            if g_OurHwnds.Has(lyr.hwnd)
                g_OurHwnds.Delete(lyr.hwnd)
        }
    }

    ; ── SIZE ────────────────────────────────────────────────────────────────
    ; A GpGFX layer is a borderless layered window: Windows gives it no frame,
    ; so it has no sizing border and no caption to drag, and until now the
    ; window was simply stuck at 1120x720 wherever it opened. Moving is
    ; already handled -- lyr.Drag() makes any bare surface a caption -- so
    ; this is the other half: a corner grip, a maximise toggle, and both
    ; remembered across restarts.

    /**
     * Resize the window AND its backing surface, then relay out.
     *
     * Both halves are needed and they are different calls: Resize() throws
     * away the Graphics surface and allocates one at the new size (without
     * it, everything past the old bounds is clipped away), while Move()
     * resizes the actual window (without it, the window stays 1120x720 and
     * the larger surface is cropped by it).
     */
    static ApplySize(nw, nh, force := false) {
        lyr := Atlas.lyr
        if !IsObject(lyr)
            return
        nw := Max(Integer(nw), Atlas.MINW)
        nh := Max(Integer(nh), Atlas.MINH)
        if (!force && nw = Atlas.W && nh = Atlas.H)
            return
        ok := true
        try {
            lyr.Resize(nw, nh)
            lyr.Move(, , nw, nh)
        } catch as e {
            ok := false
            Problem("ui", "resize to " nw "x" nh " failed: " e.Message)
        }
        ; Atlas.W/H are what every panel and THE GRIP lay themselves out
        ; against, so they must never claim a size the window does not have.
        ; Setting them first and resizing after meant one failed Resize --
        ; a DIB allocation on a 4K display, say -- moved the grip permanently
        ; outside the visible window, and from then on the corner could not be
        ; grabbed at all. Take the size back from the layer instead of
        ; assuming it took.
        Atlas.W := (ok && lyr.w >= Atlas.MINW) ? lyr.w : Max(lyr.w, Atlas.MINW)
        Atlas.H := (ok && lyr.h >= Atlas.MINH) ? lyr.h : Max(lyr.h, Atlas.MINH)
        if (!ok)
            Lumi.Toast("The window could not be resized — see Diagnostics",
                "danger", 3000)
        Atlas.Build()
    }

    static SaveSize() {
        CfgSet("winW", Atlas.W)
        CfgSet("winH", Atlas.H)
        CfgSet("winMax", Atlas.maxed ? 1 : 0)
        CfgDirty()
    }

    static ToggleMax(*) {
        lyr := Atlas.lyr
        if !IsObject(lyr)
            return
        Lumi.CloseSelect()
        if Atlas.maxed {
            r := IsObject(Atlas.restore)
                ? Atlas.restore
                : {x: lyr.x, y: lyr.y, w: Atlas.MINW, h: Atlas.MINH}
            Atlas.maxed := false
            try lyr.Move(r.x, r.y)
            Atlas.ApplySize(r.w, r.h, true)
        } else {
            Atlas.restore := {x: lyr.x, y: lyr.y, w: Atlas.W, h: Atlas.H}
            m := MonitorWorkAt(lyr.x + Atlas.W // 2, lyr.y + Atlas.H // 2)
            Atlas.maxed := true
            try lyr.Move(m.l, m.t)
            Atlas.ApplySize(m.r - m.l, m.b - m.t, true)
        }
        Atlas.SaveSize()
    }

    /**
     * The grip only ARMS the drag; the loop itself runs on a -1 timer.
     *
     * That indirection is the whole safety story. This handler is called
     * from inside GpGFX's shape dispatch, with the grip shape live on the
     * stack -- and the resize ends in Build(), which calls lyr.Clear() and
     * disposes every shape on the layer, the grip included. Running the loop
     * here would return into a disposed shape. The timer lets the dispatch
     * unwind first.
     */
    static ResizeStart(mode := "both", shp := 0, mx := 0, my := 0) {
        if Atlas.resizing {
            Problem("ui", "resize grip hit while already resizing")
            return
        }
        Atlas.resizeMode := mode
        CoordMode("Mouse", "Screen")
        MouseGetPos(&sx, &sy)
        Atlas.resizeStartX := sx
        Atlas.resizeStartY := sy
        ; Keep receiving the drag even after the pointer leaves the borderless
        ; layered window. ReleaseCapture is guaranteed in ResizeLoop.finally.
        try DllCall("user32\SetCapture", "ptr", Atlas.lyr.hwnd, "ptr")
        ; Breadcrumbs, because "the window is still not resizable" has been
        ; reported three times and there is no way to run this here. Each
        ; stage is one line in Diagnostics, so the next report says which
        ; stage it got to instead of only that it did not work.
        Problem("ui", "resize grip hit at " mx "," my
            . " (window " Atlas.W "x" Atlas.H ")")
        SetTimer(ObjBindMethod(Atlas, "ResizeLoop"), -1)
    }

    /**
     * Drag the corner against an OUTLINE, and commit once on release.
     *
     * Live-resizing the real window during the drag would mean a Build() per
     * frame, i.e. tearing down and rebuilding every shape on the layer while
     * mouse messages are still being dispatched into it -- the same shape of
     * bug as an option list left floating over a rebuilt panel. Resizing the
     * window WITHOUT rebuilding is no better: a layered window keeps showing
     * its last UpdateLayeredWindow bitmap, so it would just stretch a stale
     * 1120x720 image around. An outline on a separate click-through layer
     * costs four shapes a frame and touches neither problem.
     */
    static ResizeLoop() {
        lyr := Atlas.lyr
        if (!IsObject(lyr) || Atlas.resizing)
            return
        Atlas.resizing := true
        gh := 0
        prev := LayerStack.ActiveLayer
        nw := Atlas.W
        nh := Atlas.H
        apply := false
        try {
            Lumi.CloseSelect()
            CoordMode("Mouse", "Screen")
            sx := Atlas.resizeStartX
            sy := Atlas.resizeStartY
            w0 := Atlas.W
            h0 := Atlas.H
            ; The outline is FEEDBACK, and its own failure must not take the
            ; resize with it. It used to be built inside this same try, so a
            ; ghost that threw skipped the drag loop entirely and the window
            ; simply refused to resize with nothing said -- which is exactly
            ; what a monitor-sized ARGB surface does on a 4K reading display.
            try gh := Atlas.Ghost(MonitorAt(sx, sy))
            ; GetAsyncKeyState is independent of AutoHotkey's mouse hook. The
            ; old deferred GetKeyState("LButton", "P") could observe Up on
            ; the first timer tick and finish at the original size.
            while (DllCall("user32\GetAsyncKeyState", "int", 0x01, "short")
                    & 0x8000) {
                MouseGetPos(&cx, &cy)
                if (Atlas.resizeMode = "right" || Atlas.resizeMode = "both")
                    nw := Max(Atlas.MINW, w0 + (cx - sx))
                if (Atlas.resizeMode = "bottom" || Atlas.resizeMode = "both")
                    nh := Max(Atlas.MINH, h0 + (cy - sy))
                Atlas.GhostTo(gh, lyr.x, lyr.y, nw, nh)
                Sleep(16)
            }
            apply := (nw != w0 || nh != h0)
        } catch as e {
            Problem("ui", "resize drag failed: " e.Message
                . (e.HasProp("Line") ? " (line " e.Line ")" : ""))
        } finally {
            try DllCall("user32\ReleaseCapture")
            Atlas.GhostGone(gh)
            if (IsObject(prev))
                LayerStack.ActiveLayer := prev
            Atlas.resizing := false
        }
        if apply {
            Problem("ui", "resize drag ended at " nw "x" nh)
            Atlas.maxed := false
            Atlas.ApplySize(nw, nh)
            Atlas.SaveSize()
            Problem("ui", "resize applied: window is now "
                . Atlas.W "x" Atlas.H)
        }
    }

    /** A click-through, monitor-sized layer that draws nothing but a frame. */
    /**
     * The size outline: FOUR THIN STRIPS, not one big layer.
     *
     * It was a single layer covering the whole monitor. A layered window
     * carries an ARGB surface the size of its rect, so on a 4K reading
     * display that is a ~33 MB buffer -- allocated at the start of every
     * resize and pushed through UpdateLayeredWindow on each of ~60 frames a
     * second. At best it crawled; at worst the allocation threw, and because
     * it was built inside the drag loop's own try, throwing skipped the drag
     * and the window would not resize at all, silently.
     *
     * Four strips of three pixels is the same trick TeleportSignal already
     * uses for the same reason, and costs a few tens of kilobytes.
     */
    static Ghost(m) {
        prev := LayerStack.ActiveLayer
        strips := []
        loop 4 {
            L := Layer(m.l, m.t, 8, 8, "RadMapperSizeGhost")
            LayerStack.ActiveLayer := L
            r := Rectangle(0, 0, 8, 8, Lumi.C["cyan"], true)
            L.ClickThrough := true          ; the pointer belongs to the drag
            L.NoActivate()
            L.TopMost(true)
            strips.Push({lyr: L, rect: r})
        }
        if (IsObject(prev))
            LayerStack.ActiveLayer := prev
        return {strips: strips, t: 3}
    }

    static GhostTo(gh, x, y, w, h) {
        if !IsObject(gh)
            return
        t := gh.t
        i := 1
        for spec in [[x, y, w, t], [x, y + h - t, w, t],
                     [x, y, t, h], [x + w - t, y, t, h]] {
            s := gh.strips[i]
            try {
                s.lyr.Resize(spec[3], spec[4])
                s.rect.w := spec[3]
                s.rect.h := spec[4]
                s.lyr.Move(spec[1], spec[2], spec[3], spec[4])
                s.lyr.Draw()
            }
            i += 1
        }
    }

    static GhostGone(gh) {
        if !IsObject(gh)
            return
        for s in gh.strips {
            try s.lyr.Dispose()
        }
    }

    /**
     * The resize affordance: a VISIBLE corner grip, plus the right and bottom
     * edges. Drawn last so it all hit-tests above the panel.
     *
     * Two things were wrong before. The grip was three hairlines in the
     * dimmest colour in the palette, 24 px into a corner, with nothing to say
     * it was interactive -- so "the window is not resizable" was a fair
     * reading of it. And its hit target was a Container: an invisible,
     * never-drawn shape. Containers ARE hit-tested, but nothing about that is
     * obvious from the outside, and when a widget built on one does not
     * respond there is no way to tell a dead hit target from a dead handler.
     *
     * Both are now REAL DRAWN SHAPES. The grip is a raised tile you can see;
     * the edges are strips painted in the panel's own ground colour, so they
     * are invisible but unambiguously present. The diagonal cue is drawn ON
     * TOP of the tile and carries no handlers, and the hit test only accepts
     * shapes that have handlers, so it falls through to the tile underneath.
     */
    static Grip() {
        w := Atlas.W
        h := Atlas.H
        rightFn := ObjBindMethod(Atlas, "ResizeStart", "right")
        bottomFn := ObjBindMethod(Atlas, "ResizeStart", "bottom")
        bothFn := ObjBindMethod(Atlas, "ResizeStart", "both")

        ; Edges: invisible (ground-coloured) but real, so the whole right and
        ; bottom border resizes, not just one corner. FOURTEEN pixels, not
        ; six: six is under the width of the pointer's own hotspot margin and
        ; asks for a precision nobody should have to produce on a workstation.
        Rectangle(w - 14, Atlas.HEADH + 8, 14, h - Atlas.HEADH - 40,
            Lumi.C["abyss"], true).OnEvent("LeftMouseDown", rightFn)
        Rectangle(Atlas.NAVW + 8, h - 14, w - Atlas.NAVW - 40, 14,
            Lumi.C["abyss"], true).OnEvent("LeftMouseDown", bottomFn)

        ; The corner itself, visible on purpose, and a 26 px target.
        RoundedRectangle(w - 30, h - 30, 26, 26, 3, Lumi.C["raised2"], true)
            .OnEvent("LeftMouseDown", bothFn)
        i := 0
        while (i < 3) {                      ; cue only -- no handlers, so the
            Line(w - 10 - i * 6, h - 7, w - 7, h - 10 - i * 6,
                Lumi.C["inkDim"], 1)         ; hit test passes through it
            i += 1
        }
    }

    /**
     * Resize without the grip at all.
     *
     * Every resize so far has depended on one shape hit-test landing, and
     * "still cannot resize the window" has now been reported three times
     * against three different versions of that hit test. These two paths
     * share none of that machinery: a size is applied straight from a button
     * click and from a hotkey, both of which are demonstrably working.
     */
    static SIZES := [["Compact", 960, 640], ["Default", 1120, 720],
                     ["Wide", 1400, 900], ["Large", 1680, 1050]]

    static SizeMenu(*) {
        ; Deferred: this runs inside GpGFX's shape dispatch, with the button
        ; that was clicked live on the stack, and Chooser.Show creates and
        ; disposes layers. Same rule as everywhere else in this file.
        SetTimer(ObjBindMethod(Atlas, "SizeMenuNow"), -1)
    }

    static SizeMenuNow(*) {
        items := []
        for i, sz in Atlas.SIZES
            items.Push({label: sz[1], sub: sz[2] " x " sz[3], key: i})
        items.Push({label: "Fit this monitor", sub: "work area, no taskbar",
                    key: 0})
        ; The Chooser hands the callback the item's KEY, not its index.
        Chooser.Show("Window size",
            "the grip in the bottom-right corner does this too   ·   "
            . "Ctrl+Alt+arrows nudge by 40 px",
            items, (k) => Atlas.SizePick(k))
    }

    static SizePick(i) {
        Lumi.CloseSelect()
        Atlas.maxed := false
        if (i >= 1 && i <= Atlas.SIZES.Length) {
            Atlas.ApplySize(Atlas.SIZES[i][2], Atlas.SIZES[i][3], true)
        } else {
            lyr := Atlas.lyr
            if !IsObject(lyr)
                return
            m := MonitorWorkAt(lyr.x + Atlas.W // 2, lyr.y + Atlas.H // 2)
            try lyr.Move(m.l, m.t)
            Atlas.ApplySize(m.r - m.l, m.b - m.t, true)
        }
        Atlas.SaveSize()
    }

    /** Ctrl+Alt+arrow grows or shrinks by 40 px while the window is front. */
    static SizeNudge(dw, dh) {
        Atlas.maxed := false
        Atlas.ApplySize(Atlas.W + dw, Atlas.H + dh, true)
        Atlas.SaveSize()
        Lumi.Toast(Atlas.W " x " Atlas.H, "cyan", 900)
    }

    ; ── CHROME ──────────────────────────────────────────────────────────────

    static Build() {
        lyr := Atlas.lyr
        if !IsObject(lyr)
            return
        ; Never rebuild out from under a live Field. Build() calls
        ; lyr.Clear(), which disposes every shape on the layer -- including
        ; the box the edit loop is painting the caret into. The loop yields
        ; on Sleep, so the 700 ms status tick genuinely lands in the middle
        ; of typing; before this guard, editing anything on the Settings
        ; panel raced the tick and lost.
        ;
        ; DEFERRED, not dropped: Save closes the dialog and rebuilds while
        ; the caret may still be in the Value field (the Save handler runs
        ; nested inside that field's edit loop), and simply returning would
        ; leave the list showing the row you just replaced. Tick picks it up.
        ; ... and never through a DRAG, which is the same bug one interaction
        ; wider. A slider mutates the shapes it was built with (state.fill,
        ; state.knob) as the pointer moves; the 700 ms status tick calls
        ; Clear(), disposes exactly those shapes, and rebuilds a fresh slider
        ; from the config. So a drag lasting longer than one tick lost the
        ; shapes underneath it and simply stopped tracking -- which is why the
        ; Sniper and Boost sliders read as "not adjustable". The left button
        ; being physically down is the general form of "an interaction is in
        ; progress", and it covers the resize grip and the shelf's row-drag
        ; too. Deferred, never dropped: Tick picks it up.
        ; ... and a deferral must be able to END. Both conditions below are
        ; owned by other threads, and a thread that dies without unwinding
        ; leaves its condition set forever -- which froze the window until
        ; the script was reloaded. EditGuard drops a field count nobody is
        ; going to decrement; the click-lock test keeps a LATCHED button
        ; from reading as a live drag; and the age cap is the backstop for
        ; anything neither of those covers.
        Lumi.EditGuard()
        if (Lumi.editing > 0) {
            Atlas.pending := true    ; a LIVE field is never interrupted on a
            Atlas.pendAt := A_TickCount   ; timer, however long the typing
            return                   ; runs. EditGuard ends a dead one.
        }
        dragging := GetKeyState("LButton", "P") && !IsObject(g_ClickLock)
        if dragging {
            if !Atlas.pending {
                Atlas.pending := true
                Atlas.pendAt := A_TickCount
            }
            age := A_TickCount - Atlas.pendAt
            if (age >= 0 && age < 12000)
                return               ; a "drag" this long is a stuck button
        }
        Atlas.pending := false
        ; Any open option list belongs to the layout about to be destroyed.
        Lumi.CloseSelect()
        prevActive := LayerStack.ActiveLayer
        LayerStack.ActiveLayer := lyr
        try {
            Atlas.savedSel := IsObject(Atlas.list) ? Atlas.list.sel : 0
            lyr.Clear()
            Atlas.list := 0

        w := Atlas.W
        h := Atlas.H
        Lumi.Card(0, 0, w, h, "abyss", 0)


        ; The chrome is guarded for the same reason the panel is, one level
        ; up: Build() runs from a timer, and ANY uncaught error in it dies
        ; between lyr.Clear() and lyr.Draw() -- leaving the last good frame's
        ; pixels over the new frame's half-built shapes, which is what "the
        ; text is duplicated and slightly offset and nothing is clickable"
        ; actually is. The panel catch alone left Header, Nav, Status, the
        ; list repaint and the Grip able to do it.
        try {
            Atlas.Header()
        } catch as e {
            Problem("ui", "header failed: " e.Message)
        }
        try {
            Atlas.Nav()
        } catch as e {
            Problem("ui", "nav failed: " e.Message)
        }
        try {
            Atlas.Status()
        } catch as e {
            Problem("ui", "status failed: " e.Message)
        }

        px := Atlas.NAVW + Lumi.SP["xl"]
        py := Atlas.HEADH + Lumi.SP["lg"]
        pw := w - px - Lumi.SP["xl"]
        ph := h - py - 56

        ; A panel that throws used to take the whole window with it. Build()
        ; runs from a 700 ms timer, and an uncaught error in a timer thread
        ; kills that thread on the spot -- after lyr.Clear() has destroyed
        ; the old frame's shapes and before lyr.Draw() puts the new one on
        ; screen. What is left is the PIXELS of the last good frame with the
        ; half-built shapes of the failed one underneath, so every click
        ; lands somewhere other than where the picture says it should: "the
        ; text is duplicated and slightly offset and nothing is clickable".
        ; And because the cause is the config, not the moment, the next tick
        ; failed in the same place -- closing and reopening the window could
        ; not clear it either.
        ;
        ; Caught here rather than around the whole of Build so the header
        ; and the nav survive: a panel that cannot draw must still be one
        ; you can navigate away from.
        try {
            ; Dispatched BY NAME, not by number. The index-to-panel switch
            ; that used to live here is exactly the kind of table that drifts
            ; the moment an entry is inserted at the front -- which is what
            ; adding "Home" did -- and a drifted case here opens the wrong
            ; panel silently.
            switch Atlas.PanelName() {
                case "Home":        Atlas.PanelHome(px, py, pw, ph)
                case "Mouse":       Atlas.PanelMouse(px, py, pw, ph)
                case "Layers":      Atlas.PanelLayers(px, py, pw, ph)
                case "Keyboard":    Atlas.PanelKeys(px, py, pw, ph)
                case "Macros":      Atlas.PanelMacros(px, py, pw, ph)
                case "Apps":        Atlas.PanelApps(px, py, pw, ph)
                case "Windows":     Atlas.PanelWindows(px, py, pw, ph)
                case "Menus":       Atlas.PanelMenus(px, py, pw, ph)
                case "Pointer":     Atlas.PanelPointer(px, py, pw, ph)
                case "Settings":    Atlas.PanelSettings(px, py, pw, ph)
                case "Diagnostics": Atlas.PanelDiag(px, py, pw, ph)
            }
        } catch as e {
            Atlas.list := 0
            Atlas.PanelError(px, py, pw, ph, e)
        }
        ; a 700 ms status tick must not silently drop the row you had picked
        try {
            if (IsObject(Atlas.list) && Atlas.savedSel > 0
                && Atlas.savedSel <= Atlas.list.rows.Length) {
                Atlas.list.sel := Atlas.savedSel
                Lumi.__ListPaint(Atlas.list)
            }
        } catch as e {
            Problem("ui", "list repaint failed: " e.Message)
        }
        ; The grip is the LAST thing built, so it hit-tests above the panel --
        ; and that also means a panel that threw used to take the grip with
        ; it, which is one way "the window is not resizable" happens.
        try {
            Atlas.Grip()
        } catch as e {
            Problem("ui", "grip failed: " e.Message)
        }
            Lumi.FullErase(lyr)      ; no ghosts of the frame we just replaced
            lyr.Draw()
        } catch as e {
            Problem("ui", "frame build failed: " e.Message
                . (e.HasProp("Line") ? " (line " e.Line ")" : ""))
        } finally {
            ; A failed Clear, widget constructor or Draw must not leak the
            ; global construction target into the next dialog or timer.
            if (IsObject(prevActive) && !Lumi.Same(prevActive, lyr))
                LayerStack.ActiveLayer := prevActive
        }
    }

    /**
     * What a panel looks like when it could not be built.
     *
     * Deliberately made of nothing that can itself fail: no lists, no
     * config reads, no measured layout. Its whole job is to stay on screen
     * and carry the error text to whoever has to fix it.
     */
    static PanelError(x, y, w, h, e) {
        name := (Atlas.panel >= 1 && Atlas.panel <= Atlas.PANELS.Length)
            ? Atlas.PANELS[Atlas.panel] : String(Atlas.panel)
        msg := ""
        ln := ""
        try msg := e.Message
        try ln := " (line " e.Line ")"
        if (msg = "")
            msg := "unknown error"
        Problem("ui", "the " name " panel failed to draw: " msg ln)
        Lumi.Label(x, y, 500, name " panel could not be drawn", "title")
        Lumi.Card(x, y + 44, w, 132)
        Lumi.Label(x + 20, y + 56, w - 40, msg, "body", "left", 24)
        if (ln != "")
            Lumi.Label(x + 20, y + 82, w - 40, "at" ln, "mono", "left", 20)
        Lumi.Para(x + 20, y + 108, w - 40, 56,
            "The rest of the window still works — pick another panel from "
            . "the left. The same text is in Diagnostics; send it on and it "
            . "says exactly what to fix.", "mute")
        Lumi.Btn(x, y + 190, 190, 34, "Open Diagnostics",
            (*) => Atlas.Go(Atlas.PanelIndex("Diagnostics")), "accent")
    }

    static Header() {
        w := Atlas.W
        Rectangle(0, 3, w, Atlas.HEADH - 3, Lumi.C["surface"], true)
        Lumi.Rule(0, Atlas.HEADH, w, Lumi.C["hair"])
        ; No tagline. "reading-room input engine" under the wordmark was
        ; marketing copy in a tool the user already opened on purpose.
        Lumi.Label(Lumi.SP["xl"], 18, 260, "RadMapper", "title")
        Lumi.Label(Lumi.SP["xl"] + 108, 18, 120, "v" RM_VERSION, "mute", "left", 24)

        ; live state chips, right-aligned
        ; One status line, right-aligned, in reading order: engine, app, and
        ; only then anything transiently engaged. Six glowing pills replaced
        ; by marks that are quiet until they matter.
        ; Chips stop clear of the window buttons on the right. They used to
        ; start at w-34, i.e. underneath them.
        cx := w - 166                    ; clear of four window buttons now
        if IsObject(g_ScrollPtr) {
            cx -= 110
            Lumi.Chip(cx, 20, 106, 24, "drag scroll", "cyan")
        }
        if IsObject(g_ClickLock) {
            cx -= 132
            Lumi.Chip(cx, 20, 128, 24,
                "lock " InputLabel(g_ClickLock.held), "magenta")
        }
        app := ActiveAppName()
        if (app != "") {
            cw := Max(StrLen(app) * 7 + 20, 70)
            cx -= (cw + 14)
            Lumi.Chip(cx, 20, cw, 24, app, "cyan")
        }
        cx -= 96
        Lumi.Chip(cx, 20, 92, 24, g_Enabled ? "running" : "paused",
            g_Enabled ? "jade" : "warn")

        ; Window controls. This is a borderless layer, so it owns its chrome
        ; -- and has to get it right, because there is no system title bar
        ; underneath to fall back on.
        ;
        ; They were at y=44 with a height of 24, in a header 64 px tall, so
        ; they hung 4 px THROUGH the rule that closes the header and sat on a
        ; different baseline from the status chips they shared the corner
        ; with. One row now, vertically centred in the header, three equal
        ; buttons in the order Windows puts them: minimise, maximise, close.
        by := (Atlas.HEADH - 26) // 2
        ; A SIZE button, because every resize path so far has gone through
        ; one shape hit-test and that has now failed for three versions
        ; running. A button is the one control in this window that is
        ; certainly working.
        Lumi.Btn(w - 154, by, 32, 26, "⤢",
            (*) => Atlas.SizeMenu(), "ghost")
        Lumi.Btn(w - 118, by, 32, 26, "—",
            (*) => Atlas.Minimize(), "ghost")
        Lumi.Btn(w - 82, by, 32, 26, Atlas.maxed ? "❐" : "▢",
            (*) => Atlas.ToggleMax(), "ghost")
        Lumi.Btn(w - 46, by, 32, 26, "✕", (*) => Atlas.Hide(), "ghost")
    }

    /**
     * Make the settings window a real APPLICATION window: taskbar button,
     * Alt+Tab entry, a title.
     *
     * GpGFX creates every layer with WS_EX_TOOLWINDOW, which is the correct
     * default for what layers usually are -- toasts, overlays, HUDs -- and is
     * precisely the style that keeps a window OUT of the taskbar and out of
     * the Alt+Tab list. For a HUD that is what you want. For the settings
     * window it meant that once anything covered it, there was no way back to
     * it except the tray icon or the hotkey: it was not, as far as the shell
     * was concerned, an app at all.
     *
     * Cleared here and WS_EX_APPWINDOW set in its place. The shell only
     * re-reads these two on a hide/show cycle, so the window is bounced --
     * which is invisible at startup and is why this runs before the first
     * Build. THE MAIN WINDOW ONLY: the shelves, the chooser, the switcher and
     * the toasts stay tool windows, because a clipboard popup that adds a
     * taskbar button every time it opens would be its own kind of awful.
     */
    static AppWindow(lyr) {
        static GWL_EXSTYLE := -20
        static getFn := (A_PtrSize = 8) ? "GetWindowLongPtrW" : "GetWindowLongW"
        static setFn := (A_PtrSize = 8) ? "SetWindowLongPtrW" : "SetWindowLongW"
        static GWLP_HWNDPARENT := -8
        try {
            hwnd := lyr.hwnd
            ; DISOWN IT FIRST. GpGFX gives every layer after the first an
            ; OWNER -- whichever layer happened to be created first, which on
            ; a normal start is a toast, not this window. An owned window
            ; never gets a taskbar button and never appears in Alt+Tab no
            ; matter what its extended style says, so setting WS_EX_APPWINDOW
            ; without this would have changed nothing.
            DllCall("user32\" setFn, "ptr", hwnd, "int", GWLP_HWNDPARENT,
                "ptr", 0)
            ex := DllCall("user32\" getFn, "ptr", hwnd, "int", GWL_EXSTYLE, "ptr")
            ex := (ex & ~0x00000080) | 0x00040000   ; -TOOLWINDOW +APPWINDOW
            DllCall("user32\" setFn, "ptr", hwnd, "int", GWL_EXSTYLE, "ptr", ex)
            DllCall("user32\ShowWindow", "ptr", hwnd, "int", 0)   ; SW_HIDE
            DllCall("user32\ShowWindow", "ptr", hwnd, "int", 5)   ; SW_SHOW
            WinSetTitle("RadMapper " RM_VERSION, "ahk_id " hwnd)
        }
    }

    /**
     * Minimise. There was no way to do this at all: a borderless layered
     * window has no system minimise, and the header only ever offered close
     * and maximise. It comes back from the tray icon or the settings hotkey,
     * both of which route through Show(), which now un-minimises first.
     */
    static Minimize(*) {
        Lumi.CloseSelect()
        if IsObject(Atlas.lyr) {
            try WinMinimize("ahk_id " Atlas.lyr.hwnd)
        }
    }

    static Nav() {
        Rectangle(0, Atlas.HEADH, Atlas.NAVW, Atlas.H - Atlas.HEADH,
            Lumi.C["surface"], true)
        Line(Atlas.NAVW, Atlas.HEADH, Atlas.NAVW, Atlas.H, Lumi.C["hair"], 1)
        y := Atlas.HEADH + Lumi.SP["lg"]
        ; The rail used to step a fixed 44 px per entry. With eleven entries
        ; that runs THROUGH the engine switch and the panic button at the
        ; bottom on any window shorter than about 780 px -- and the minimum
        ; is 640. The pitch is derived from the space that is actually there
        ; now, and never grows past the 44 the design was drawn at.
        floorY := Atlas.H - 128           ; the rule above the engine switch
        pitch := 44
        if (Atlas.PANELS.Length > 0) {
            room := floorY - y
            pitch := ClampInt(room // Atlas.PANELS.Length, 30, 44, 44)
        }
        rowH := Max(24, pitch - 6)
        i := 1
        for name in Atlas.PANELS {
            active := (i = Atlas.panel)
            ; the row itself is the button: opaque tone, hover on the same
            ; shape, no transparent overlay (see Lumi.Clear for why)
            bg := active ? Lumi.Mix(Lumi.C["surface"], Lumi.C["magenta"], 0.22)
                         : Lumi.C["surface"]
            row := RoundedRectangle(Lumi.SP["md"], y, Atlas.NAVW - 24, rowH,
                Lumi.RAD["row"], bg, true)
            row.Hover(Lumi.Mix(bg, Lumi.C["cyan"], 0.20), bg)
            row.OnEvent("Click", Atlas.NavGo(i))
            if active
                Rectangle(Lumi.SP["md"], y + 4, 2, Max(12, rowH - 8),
                    Lumi.C["magenta"], true)
            Lumi.Label(Lumi.SP["md"] + 18, y, 150, name,
                active ? "body" : "dim", "left", rowH)
            y += pitch
            i += 1
        }
        ; engine switch lives in the rail: it is global, not panel-scoped
        Lumi.Rule(Lumi.SP["md"], Atlas.H - 116, Atlas.NAVW - 24, Lumi.C["hairSoft"])
        Lumi.Toggle(Lumi.SP["md"], Atlas.H - 96, "", g_Enabled,
            (v) => Atlas.ToggleEngine(v))
        Lumi.Label(Lumi.SP["md"] + 56, Atlas.H - 96, 120,
            g_Enabled ? "Engine on" : "Engine off", "dim", "left", 22)
        ; "Panic release" is the name of the feature, not a description of
        ; what it does for you. The word on the button is now the job.
        Lumi.Btn(Lumi.SP["md"], Atlas.H - 62, Atlas.NAVW - 24, 30,
            "Unstick my buttons", (*) => Atlas.Unstick(), "danger")
    }

