; v1.0 (E1): one "Layer (hold to arm)" selector replaces the old Layer + While
; dropdowns. Choices: Base, each single button (depth-1), and each unordered
; button pair (depth-2 nesting). Matching treats a path as an unordered set of
; held buttons, so one presentation order per pair suffices.
; LAYER_BASE_LABEL is a top-level global (defined near BUTTONS, above Init()).
LayerChoices() {
    out := [LAYER_BASE_LABEL]
    for b in BUTTONS
        out.Push("Hold " InputLabel(b))
    for k in KeyInputsInUse()                ; v0.3: a KEY can host a layer too
        out.Push("Hold " k)                  ; (CapsLock is the obvious one) --
    for i, a in BUTTONS {                    ; the engine never cared which

        for j, b in BUTTONS {
            if (j > i)
                out.Push("Hold " InputLabel(a) " + " InputLabel(b))
        }
    }
    return out
}

; Every key already used as an input somewhere in the config, in config
; order, de-duplicated. Keys have no enumerable list, so the config is the
; only source for "which keys exist" -- bind a key first, then it can host a
; layer.
KeyInputsInUse() {
    seen := Map()
    seen.CaseSense := "Off"
    out := []
    for row in g_Cfg["bindings"] {
        b := MGet(row, "button", "")
        if (IsKeyInput(b) && !seen.Has(b)) {
            seen[b] := 1
            out.Push(b)
        }
        for prt in LayerParts(row) {
            if (IsKeyInput(prt) && !seen.Has(prt)) {
                seen[prt] := 1
                out.Push(prt)
            }
        }
    }
    return out
}

; Selector label -> stored layer code ("*" or "BTN" or "BTN1/BTN2").
LayerCodeFromLabel(label) {
    if (label = "" || label = LAYER_BASE_LABEL)
        return "*"
    s := (SubStr(label, 1, 5) = "Hold ") ? SubStr(label, 6) : label
    codes := []
    for p in StrSplit(s, " + ")
        codes.Push(InputCodeFromLabel(Trim(p)))
    out := ""
    for c in codes
        out .= (out = "" ? "" : "/") c
    return out = "" ? "*" : out
}

; Stored layer code -> selector label.
LayerLabelFromCode(code) {
    if (code = "*" || code = "" || code = "Base")
        return LAYER_BASE_LABEL
    labs := ""
    for p in StrSplit(code, "/") {
        if (p != "")
            labs .= (labs = "" ? "" : " + ") InputLabel(p)
    }
    return labs = "" ? LAYER_BASE_LABEL : "Hold " labs
}

; Compact layer for the Mappings list ("Base" or the raw held-button path).
LayerDisp(code) {
    return (code = "*" || code = "" || code = "Base") ? "Base" : code
}

; Shared look for all pop-up dialogs.
StyleDlg(dlg) {
    dlg.BackColor := "F5F6F8"
    dlg.SetFont("s10", "Segoe UI")
}

; Record one keyboard combo and return it in Send syntax ("^+{F9}"), or ""
; if cancelled (Esc / 10 s timeout). Our own keyboard hotkeys are suspended
; during capture so recording e.g. the GUI hotkey can't recurse.
RecordCombo() {
    global g_RecHook
    static busy := false
    if busy
        return ""
    busy := true
    out := ""
    try {
        for hk in g_KbRegistered
            try Hotkey(hk, "Off")
        HUD("Recording: press a key combo (Esc cancels)")
        ih := InputHook("L0 T10")
        ih.KeyOpt("{All}", "ES")             ; any key ends capture, suppressed
        for m in ["LCtrl", "RCtrl", "LShift", "RShift", "LAlt", "RAlt", "LWin", "RWin"]
            ih.KeyOpt("{" m "}", "-ES")      ; modifiers neither end nor suppress
        g_RecHook := ih                      ; ModalClose stops a live capture
        ih.Start()
        ih.Wait()
        if (ih.EndReason = "EndKey" && ih.EndKey != "Escape") {
            mods := ""
            if GetKeyState("Ctrl", "P")
                mods .= "^"
            if GetKeyState("Alt", "P")
                mods .= "!"
            if GetKeyState("Shift", "P")
                mods .= "+"
            if (GetKeyState("LWin", "P") || GetKeyState("RWin", "P"))
                mods .= "#"
            out := mods "{" ih.EndKey "}"
        }
    } finally {
        g_RecHook := 0
        busy := false
        RegisterKbHotkeys()
    }
    HUD(out != "" ? "Recorded: " out : "Recording cancelled")
    return out
}

RecIntoEdit(ed) {
    v := RecordCombo()
    if (v != "")
        try ed.Value := v                    ; dialog may have closed mid-capture
}

InsertToken(ed, token, *) {
    ed.Value := ed.Value . token
}

; Visual keycode picker (Vial-style): arm modifiers, click a key, and the exact
; Send token (braces and all) is appended to the Value field -- so a function
; key is never entered as bare "F7" (which sends the letter F then a 7). Rec
; still records a live combo; this replaces the old categorized dropdown menu.
KeyPicker(owner, ed) {
    owner := ValueHostHwnd(owner)
    kp := Gui("+Owner" owner " -MinimizeBox -MaximizeBox", "Pick a key")
    kp.BackColor := "F5F6F8"
    kp.SetFont("s9", "Segoe UI")
    kp.AddText("x12 y10 w520",
        "Arm modifiers, then click a key. Each click appends one Send token to the Value field.")
    cbCtrl  := kp.AddCheckbox("x12 y+8 w78", "Ctrl  ^")
    cbAlt   := kp.AddCheckbox("x+4 yp w70", "Alt  !")
    cbShift := kp.AddCheckbox("x+4 yp w82", "Shift  +")
    cbWin   := kp.AddCheckbox("x+4 yp w70", "Win  #")
    kp.AddText("x12 y+12 w52", "Value:")
    prev := kp.AddEdit("x+4 yp-3 w452 ReadOnly", ed.Value)

    ins(token, *) {
        pre := (cbCtrl.Value ? "^" : "") (cbAlt.Value ? "!" : "") (cbShift.Value ? "+" : "") (cbWin.Value ? "#" : "")
        InsertToken(ed, pre . token)
        prev.Value := ed.Value
        cbCtrl.Value := 0
        cbAlt.Value := 0
        cbShift.Value := 0
        cbWin.Value := 0
    }
    clr(*) {
        ed.Value := ""
        prev.Value := ""
    }

    fkeys := []
    loop 24
        fkeys.Push(["F" A_Index, "{F" A_Index "}"])
    KPSection(kp, "Function", fkeys, 8, 44, ins)

    letters := []
    loop 26
        letters.Push([Chr(64 + A_Index), Chr(96 + A_Index)])
    KPSection(kp, "Letters", letters, 13, 36, ins)

    nums := []
    for d in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]
        nums.Push([d, d])
    KPSection(kp, "Numbers", nums, 10, 44, ins)

    nav := [["Up", "{Up}"], ["Down", "{Down}"], ["Left", "{Left}"], ["Right", "{Right}"],
        ["Home", "{Home}"], ["End", "{End}"], ["PgUp", "{PgUp}"], ["PgDn", "{PgDn}"],
        ["Ins", "{Insert}"], ["Del", "{Delete}"]]
    KPSection(kp, "Navigation", nav, 10, 48, ins)

    edt := [["Enter", "{Enter}"], ["Tab", "{Tab}"], ["Esc", "{Esc}"], ["Space", "{Space}"],
        ["Bksp", "{Backspace}"], ["PrtSc", "{PrintScreen}"], ["Menu", "{AppsKey}"]]
    KPSection(kp, "Editing", edt, 10, 52, ins)

    npad := []
    loop 10
        npad.Push(["N" (A_Index - 1), "{Numpad" (A_Index - 1) "}"])
    for p in [["N+", "{NumpadAdd}"], ["N-", "{NumpadSub}"], ["N*", "{NumpadMult}"],
        ["N/", "{NumpadDiv}"], ["N.", "{NumpadDot}"], ["NEnt", "{NumpadEnter}"]]
        npad.Push(p)
    KPSection(kp, "Numpad", npad, 8, 50, ins)

    media := [["Vol+", "{Volume_Up}"], ["Vol-", "{Volume_Down}"], ["Mute", "{Volume_Mute}"],
        ["Play", "{Media_Play_Pause}"], ["Next", "{Media_Next}"], ["Prev", "{Media_Prev}"],
        ["Bk", "{Browser_Back}"], ["Fwd", "{Browser_Forward}"]]
    KPSection(kp, "Media / browser", media, 8, 54, ins)

    kp.AddText("x12 y+14 w520 cGray",
        "Tip: arm Shift + a letter for uppercase; Ctrl + a letter for shortcuts (e.g. Ctrl+C).")
    kp.AddButton("x12 y+8 w96 h28", "Clear value").OnEvent("Click", clr)
    kp.AddButton("x+8 yp w96 h28 Default", "Done").OnEvent("Click", (*) => KPClose(kp, owner))
    kp.OnEvent("Close", (*) => KPClose(kp, owner))
    kp.OnEvent("Escape", (*) => KPClose(kp, owner))

    ; Modal to its dialog. The dialog is disabled while the picker is up, so the
    ; user cannot OK the dialog with the picker still open -- which would destroy
    ; the picker via ownership WITHOUT cleanup (leaking its hwnd in g_OurHwnds)
    ; and leave focus off the dialog, routing the OK click to the engine instead
    ; of the OK button (so the binding would never be saved).
    try WinSetEnabled(false, "ahk_id " owner)
    g_OurHwnds[kp.Hwnd] := 1                  ; ours -> engine passes clicks through
    ApplyTheme(kp)
    kp.Show()
}

; Close the picker and hand focus back to its dialog, so the following OK click
; is handled as one of ours (passthru), never routed to the engine or a window
; behind it.
KPClose(kp, owner) {
    owner := ValueHostHwnd(owner)
    ; Re-enable FIRST. A disabled owner cannot take the foreground, so the
    ; order here is load-bearing: swap it and the dialog stays dead behind a
    ; picker that no longer exists.
    try WinSetEnabled(true, "ahk_id " owner)
    if g_OurHwnds.Has(kp.Hwnd)
        g_OurHwnds.Delete(kp.Hwnd)
    kp.Destroy()
    try WinActivate("ahk_id " owner)
}

; The pickers are shared by the classic Win32 dialogs and the vector binding
; dialog, so "the window that owns me" arrives either as a Gui, as a GpGFX
; Layer, or already as a raw hwnd. Normalise it once, here, instead of
; teaching every picker about all three.
ValueHostHwnd(owner) {
    if !IsObject(owner)
        return owner                 ; already an hwnd
    try return owner.Hwnd            ; Gui and GpGFX Layer both answer this
    return 0                         ; (property lookup is case-insensitive)
}

/**
 * Makes a Lumi vector Field look like a Win32 Edit control to the pickers.
 *
 * Rec, Keys and Input all speak one language -- `ed.Value` -- and they are
 * the reason the classic dialogs are usable without memorising Send syntax.
 * The vector dialog had no such tools at all, so its Value field was the
 * only way in, and when that field turned out not to be editable there was
 * no way in at all: "I can't map keys because the value field is not
 * editable". Rather than fork the pickers, adapt the field.
 */
class FieldEdit {
    __New(state) {
        this.state := state
    }
    Value {
        get => Lumi.FieldValue(this.state)
        set => Lumi.FieldSet(this.state, value)
    }
}

; One titled, row-wrapping grid of key buttons inside the picker. Each button
; inserts its Send token (prefixed with any armed modifiers) into the field.
KPSection(g, title, items, cols, bw, clickFn) {
    g.AddText("x12 y+12 w520 cGray", title)
    i := 0
    for it in items {
        i += 1
        opt := (Mod(i - 1, cols) = 0) ? "x12 y+4" : "x+4 yp"
        g.AddButton(opt " w" bw " h26", it[1]).OnEvent("Click", clickFn.Bind(it[2]))
    }
}

; Add the Rec / key-picker / input-picker buttons to the right of a value
; Edit control. "Input" is v0.3.1: the native and drag actions take an INPUT
; NAME, and before this there was no way to enter one except by typing an
; internal code the GUI never displays -- which is why remapping a button to
; another button appeared impossible.
AddValueTools(dlg, ed) {
    dlg.AddButton("x+6 yp-1 w44 h26", "Rec").OnEvent("Click", (*) => RecIntoEdit(ed))
    dlg.AddButton("x+3 yp w48 h26", "Keys").OnEvent("Click", (*) => KeyPicker(dlg.Hwnd, ed))
    dlg.AddButton("x+3 yp w52 h26", "Input").OnEvent("Click", (*) => InputPicker(dlg.Hwnd, ed))
}

; Pick the input a "Native input" / "Native drag" / "Click lock" row points
; at. Sets the field (an input is one thing, never a sequence) and shows the
; code that is actually stored next to the friendly label.
InputPicker(owner, ed) {
    owner := ValueHostHwnd(owner)
    ip := Gui("+Owner" owner " -MinimizeBox -MaximizeBox", "Pick an input")
    ip.BackColor := "F5F6F8"
    ip.SetFont("s9", "Segoe UI")
    ip.AddText("x12 y10 w420", "The input this action presses instead. Leave"
        . " the value blank in the dialog to mean “this same input”.")
    ip.AddText("x12 y+10 w52", "Value:")
    prev := ip.AddEdit("x+4 yp-3 w352 ReadOnly", ed.Value)
    set(code, *) {
        ed.Value := code
        prev.Value := code
    }
    y := 74
    for code in BUTTONS {
        ip.AddButton("x12 y" y " w180 h28", InputLabel(code)).OnEvent("Click", set.Bind(code))
        ip.AddText("x+8 yp+6 w150", code)
        y += 34
    }
    for code in WHEELS {
        ip.AddButton("x12 y" y " w180 h28", InputLabel(code)).OnEvent("Click", set.Bind(code))
        ip.AddText("x+8 yp+6 w150", code)
        y += 34
    }
    ip.AddText("x12 y" (y + 6) " w420 cGray", "A KEY works here too — type its"
        . " name (Numpad1, F8, CapsLock) or record it with Rec.")
    ip.AddButton("x12 y" (y + 34) " w96 h28 Default", "Done").OnEvent("Click", (*) => KPClose(ip, owner))
    ip.OnEvent("Close", (*) => KPClose(ip, owner))
    ip.OnEvent("Escape", (*) => KPClose(ip, owner))
    try WinSetEnabled(false, "ahk_id " owner)
    g_OurHwnds[ip.Hwnd] := 1
    ApplyTheme(ip)
    ip.Show()
}

; Resolve + check an action value that names an input or a modifier, shared by
; the binding and key dialogs. Returns the value to store, or "" after showing
; the reason (caller aborts on ok = false).
ValidateActionValue(owner, atype, raw, &ok) {
    ok := true
    hwnd := ValueHostHwnd(owner)
    v := raw
    if ((atype = "keys" || atype = "keysrepeat" || atype = "ps_keys") && Trim(raw) = "") {
        ok := false
        MsgBox("Record a shortcut or choose Disabled to leave this input empty.",
            "RadMapper", "Icon! Owner" hwnd)
        return ""
    }
    if (atype = "radial" && Trim(raw) != "" && !MenuByName(Trim(raw))) {
        ok := false
        MsgBox("No menu named '" Trim(raw) "'. Choose a name from Menus, or leave "
            . "Details empty for the automatic menu.", "RadMapper", "Icon! Owner" hwnd)
        return ""
    }
    if (atype = "radial")
        return Trim(raw)
    if (atype = "native" || atype = "dblclick" || atype = "dragmove"
        || atype = "clicklock") {
        v := ResolveInputValue(raw)
        if (v = "")                          ; blank is legal: "this input"
            return ""                        ; (click lock: the held button)
        if !IsInputTarget(v) {
            ok := false
            MsgBox("'" Trim(raw) "' is not an input RadMapper can press.`n`n"
                . "Use the Input button to pick a mouse button, or type a key"
                . " name (Numpad1, F8). Leave it blank to mean this same"
                . " input.", "RadMapper", "Iconx Owner" . hwnd)
            return ""
        }
        return v
    }
    if (atype = "moddrag") {
        m := IsModifierName(Trim(raw))
        if (m = "") {
            ok := false
            MsgBox("'" Trim(raw) "' is not a modifier.`n`nUse LAlt, LCtrl,"
                . " LShift or LWin -- it is held down while the left button"
                . " drags.", "RadMapper", "Iconx Owner" . hwnd)
            return ""
        }
        return m
    }
    return raw
}

; Wheel/tilt inputs only make sense with the "turn" event; keep the event
; dropdown consistent as the user browses inputs.
AutoTurnEvent(ddBtn, ddEvent) {
    code := InputCodeFromLabel(ddBtn.Text)
    if IsWheel(code)
        ChooseText(ddEvent, EVENT_ITEMS, "turn")
    else if (ddEvent.Text = "turn")
        ChooseText(ddEvent, EVENT_ITEMS, "tap")
}

; Select a dropdown item by EXACT text. The control's own Choose(string) does
; prefix matching, which could silently pick "BaseAlt" when restoring "Base".
ChooseText(ddl, items, text, fallback := 1) {
    for i, it in items {
        if (it = text) {
            ddl.Choose(i)
            return
        }
    }
    ddl.Choose(fallback)
}

ActIndexOf(code) {
    for i, c in ACT_CODES {
        if (c = code)
            return i
    }
    return ACT_CODES.Length                  ; "none"
}

; The hint for an action code, or "" for a code the table does not list.
; A retired type still on disk -- a pre-v0.3.4 "teleport" row naming a
; monitor NUMBER survives MigrateRow deliberately -- used to throw out of the
; dialog builder on the ACT_HINTS lookup, which leaves a half-built modal
; window over the reading screen. The vector dialog already guarded this.
ActHintOf(code) {
    return ACT_HINTS.Has(code) ? ACT_HINTS[code] : ""
}

/** The dropdown label for an action code -- a readable fallback name. */
ActLabelOf(code) {
    i := ActIndexOf(code)
    return ACT_LABELS.Has(i) ? ACT_LABELS[i] : code
}

AddModBoxes(dlg, x, y, mods) {
    boxes := {}
    boxes.ctrl := dlg.AddCheckbox("x" x " y" y, "Ctrl")
    boxes.alt := dlg.AddCheckbox("x+10", "Alt")
    boxes.shift := dlg.AddCheckbox("x+10", "Shift")
    boxes.win := dlg.AddCheckbox("x+10", "Win")
    boxes.ctrl.Value := InStr(mods, "^") ? 1 : 0
    boxes.alt.Value := InStr(mods, "!") ? 1 : 0
    boxes.shift.Value := InStr(mods, "+") ? 1 : 0
    boxes.win.Value := InStr(mods, "#") ? 1 : 0
    return boxes
}

ReadModBoxes(boxes) {
    s := ""
    if boxes.ctrl.Value
        s .= "^"
    if boxes.alt.Value
        s .= "!"
    if boxes.shift.Value
        s .= "+"
    if boxes.win.Value
        s .= "#"
    return s
}

; --- binding dialog --------------------------------------------------------------

; preset ({btn, app, layer} object) prefills a NEW row's context -- the
; mouse-map view opens dialogs already aimed at the clicked zone + selectors.
BindingDlg(editRow, preset := 0) {
    row := editRow ? g_Cfg["bindings"][editRow] : 0
